@{
    ViewData["Title"] = "Restaurant Management System";
    Layout = "_BusinessLayout";
}

<div class="hero-section">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <h1 class="main-heading">Transform Your Restaurant Operations</h1>
                <p class="main-subtitle">The all-in-one management system that simplifies your restaurant workflow</p>
                <div class="cta-container">
                    <a href="@Url.Action("Register", "BusinessAccount")" class="btn btn-primary btn-lg">Start Now</a>
                    <a href="#features" class="btn btn-outline-secondary btn-lg ms-3">Learn More</a>
                </div>
            </div>
            <div class="col-md-6">
                <!-- image placeholder-->
                <img src="https://via.placeholder.com/600x400" alt="Restaurant Dashboard Preview" class="img-fluid hero-image">
            </div>
        </div>
    </div>
</div>

<div class="features-section" id="features">
    <div class="container">
        <h2 class="section-heading text-center">Everything You Need to Manage Your Restaurant</h2>

        <div class="row mt-5">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-utensils"></i>
                    </div>
                    <h3>Digital Menu Management</h3>
                    <p>Create beautiful digital menus with easy editing options. Update prices, add specials, and customize your design in minutes.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-paint-brush"></i>
                    </div>
                    <h3>Custom Design Options</h3>
                    <p>Match your brand with customizable designs. Choose from templates or create your own look with our intuitive design tools.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <h3>Staff Management</h3>
                    <p>Handle scheduling, permissions, and performance tracking all in one place. Keep your team organized and efficient.</p>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                    <h3>Analytics Dashboard</h3>
                    <p>Gain insights into your business with comprehensive analytics. Track sales, popular items, and customer preferences.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-mobile-alt"></i>
                    </div>
                    <h3>Mobile Friendly</h3>
                    <p>Access your management system from anywhere. Make updates on the go with our responsive design.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fas fa-sync"></i>
                    </div>
                    <h3>Real-time Updates</h3>
                    <p>Changes reflect immediately across all platforms. Keep your menu and operations in sync at all times.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="cta-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h2>Ready to Transform Your Restaurant Management?</h2>
                <p>Join thousands of restaurant owners who've simplified their operations and increased their profits.</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a href="@Url.Action("Register", "BusinessAccount")" class="btn btn-primary btn-lg">Start Now</a>
            </div>
        </div>
    </div>
</div>

