@{
    Layout = "_ManagerLayout";
}

@* @model RestaurantAnalyticsViewModel *@

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <h1 class="mb-4">Restaurant Analytics Dashboard</h1>

            <!-- Date Range Filter -->
            <div class="card mb-4">
	            <input type="month" id="dateInput" class="form-control"
	                   value="@DateTime.Now.ToString("yyyy-MM")"
	                   max="@DateTime.Now.ToString("yyyy-MM")"
	                   onchange="onDateChange()" style="width: 150px;" />

            </div>

            <!-- KPI Cards -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="card text-white bg-success">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Total Revenue</h5>
                        </div>
                        <div class="card-body">
                            <h2 class="card-text">3333</h2>
                            <small>For selected period</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-white bg-info">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Total Orders</h5>
                        </div>
                        <div class="card-body">
                            <h2 class="card-text">22</h2>
                            <small>Orders completed</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card text-white bg-warning">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Average Order Value</h5>
                        </div>
                        <div class="card-body">
                            <h2 class="card-text">2</h2>
                            <small>Per order</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="row">
                <!-- Revenue Trend Chart -->
                <div class="col-lg-8 mb-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Revenue Trend</h5>
                        </div>
                        <div class="card-body">
                            <canvas id="revenueTrendChart" width="400" height="200"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Orders by Hour Chart -->
                <div class="col-lg-4 mb-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Orders by Hour</h5>
                        </div>
                        <div class="card-body">
                            <canvas id="ordersByHourChart" width="300" height="200"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Best Selling Items Chart -->
                <div class="col-lg-6 mb-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Best Selling Menu Items</h5>
                        </div>
                        <div class="card-body">
                            <canvas id="bestSellingItemsChart" width="400" height="300"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Revenue by Category Chart -->
                <div class="col-lg-6 mb-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Revenue by Category</h5>
                        </div>
                        <div class="card-body">
                            <canvas id="revenueByCategoryChart" width="400" height="300"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Best Selling Items Table -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title mb-0">Top Menu Items Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Rank</th>
                                            <th>Item Name</th>
                                            <th>Category</th>
                                            <th>Quantity Sold</th>
                                            <th>Revenue</th>
                                            <th>Avg Price</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @* @if (Model.BestSellingItems != null && Model.BestSellingItems.Any()) *@
                                        @* { *@
                                        @*     @for (int i = 0; i < Model.BestSellingItems.Count(); i++) *@
                                        @*     { *@
                                        @*         var item = Model.BestSellingItems.ElementAt(i); *@
                                        @*         <tr> *@
                                        @*             <td><span class="badge bg-primary">@(i + 1)</span></td> *@
                                        @*             <td><strong>@item.ItemName</strong></td> *@
                                        @*             <td>@item.Category</td> *@
                                        @*             <td>@item.QuantitySold</td> *@
                                        @*             <td>@item.Revenue.ToString("C")</td> *@
                                        @*             <td>@item.AveragePrice.ToString("C")</td> *@
                                        @*         </tr> *@
                                        @*     } *@
                                        @* } *@
                                        @* else *@
                                        @* { *@
                                        @*     <tr> *@
                                        @*         <td colspan="6" class="text-center text-muted">No data available for selected period</td> *@
                                        @*     </tr> *@
                                        @* } *@
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>

       function onDateChange() {
        loadRevenueTrendChart();
        loadOrdersByHourChart();
		loadBestSellingItemsChart();
		loadRevenueByCategoryChart();
    }

    let revenueTrendChartInstance = null;
    let ordersByHourChartInstance = null;
	let bestSellingItemsInstance = null;
	let revenueByCategoryChartInstance = null;

        async function loadRevenueTrendChart() {
        const monthInput = document.getElementById('dateInput');
        const selectedDateStr = monthInput.value;

        const response = await fetch(`/Business/GetRevenueByDataRange?date=${selectedDateStr}`);
        const json = await response.json();

        const ctx = document.getElementById('revenueTrendChart').getContext('2d');

        // Destroy previous chart instance if it exists
        if (revenueTrendChartInstance) {
            revenueTrendChartInstance.destroy();
        }

        revenueTrendChartInstance = new Chart(ctx, {
            type: 'line',
            data: {
                labels: json.labels,
                datasets: [{
                    label: 'Revenue (Last 30 Days)',
                    data: json.data,
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });
    }

    async function loadOrdersByHourChart() {
        const monthInput = document.getElementById('dateInput');
        const selectedDateStr = monthInput.value;

        const response = await fetch(`/Business/GetHourlyOrders?date=${selectedDateStr}`);
        const json = await response.json();

        const ctx = document.getElementById('ordersByHourChart').getContext('2d');

        // Destroy previous chart instance if it exists
        if (ordersByHourChartInstance) {
            ordersByHourChartInstance.destroy();
        }

        ordersByHourChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: json.labels,
                datasets: [{
                    label: 'Orders by Hour',
                    data: json.data,
                    backgroundColor: 'rgba(54, 162, 235, 0.8)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    },
                    x: {
                        title: { display: true, text: 'Hour of Day' }
                    }
                }
            }
        });
    }

    async function loadBestSellingItemsChart() {
        const monthInput = document.getElementById('dateInput');
        const selectedDateStr = monthInput.value;

         const response = await fetch(`/Business/GetTopSellingItems?date=${selectedDateStr}`);
        const json = await response.json();

        const ctx = document.getElementById('bestSellingItemsChart').getContext('2d');

          if (bestSellingItemsInstance) {
            bestSellingItemsInstance.destroy();
        }

        bestSellingItemsInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: json.labels,
                datasets: [{
                    label: 'Quantity Sold',
                    data: json.data,
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.8)',
                        'rgba(54, 162, 235, 0.8)',
                        'rgba(255, 205, 86, 0.8)',
                        'rgba(75, 192, 192, 0.8)',
                        'rgba(153, 102, 255, 0.8)',
                        'rgba(255, 159, 64, 0.8)',
                        'rgba(199, 199, 199, 0.8)',
                        'rgba(83, 102, 255, 0.8)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                indexAxis: 'y',
                scales: {
                    x: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Quantity Sold'
                        }
                    }
                }
            }
        });
    }



        async function loadRevenueByCategoryChart() {

        const monthInput = document.getElementById('dateInput');
        const selectedDateStr = monthInput.value;
        const response = await fetch(`/Business/GetRevenueByCategory?date=${selectedDateStr}`);
        const json = await response.json();
        const ctx = document.getElementById('revenueByCategoryChart').getContext('2d');

        if(revenueByCategoryChartInstance)
			revenueByCategoryChartInstance.destroy();

         revenueByCategoryChartInstance =  new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: json.labels,
                datasets: [{
                    data: json.data,
                    backgroundColor: [
                        '#FF6384',
                        '#36A2EB',
                        '#FFCE56',
                        '#4BC0C0',
                        '#9966FF',
                        '#FF9F40'
                    ],
                    hoverBackgroundColor: [
                        '#FF6384',
                        '#36A2EB',
                        '#FFCE56',
                        '#4BC0C0',
                        '#9966FF',
                        '#FF9F40'
                    ]
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.label + ': $' + context.parsed.toLocaleString();
                            }
                        }
                    }
                }
            }
        });
    }


</script>
