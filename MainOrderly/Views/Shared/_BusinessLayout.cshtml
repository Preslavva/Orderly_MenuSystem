@using MainOrderly.WebApp.Extensions
@using Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var user = Context.Session.GetAuthenticatedUser();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/Business.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light box-shadow">
        <div class="container">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Business" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#features">Features</a>
                    </li>
                </ul>
                <div>
                    @if (user != null)
                    {
                        <div class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                @user.FullName
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="userDropdown">
                                @if (user.Roles.Contains("Owner") || user.Roles.Contains("Manager"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Manager" asp-action="MenuItems">Menu Management</a></li>
                                    <li><a class="dropdown-item" asp-controller="Manager" asp-action="IngredientList">Ingredients</a></li>
                                }

                                @if (user.Roles.Contains("Owner") || user.Roles.Contains("Manager") || user.Roles.Contains("Chef"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Kitchen" asp-action="Dashboard">Kitchen Dashboard</a></li>
                                }

                                @if (user.Roles.Contains("Owner") || user.Roles.Contains("Manager") || user.Roles.Contains("Waiter"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Waiter" asp-action="Orders">Waiter Tab</a></li>
                                }

                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="BusinessAccount" asp-action="Logout">Logout</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "BusinessAccount")" class="btn btn-primary">Login</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<main role="main">
    @RenderBody()
</main>



<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
                                    