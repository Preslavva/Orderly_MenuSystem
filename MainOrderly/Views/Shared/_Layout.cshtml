@*
    _Layout.cshtml with conditional header/footer
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OrderlyTest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto&family=Lobster&display=swap" rel="stylesheet">
    @{
        // Pick a default if FontName was not supplied
        var fontFamily = (ViewBag.FontName ?? "Arial").ToString();

        // Google Fonts expects spaces as +
        var gfontParam = Uri.EscapeDataString(fontFamily.Replace(" ", "+"));
    }

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=@gfontParam&display=swap">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OrderlyTest.styles.css" asp-append-version="true" />

    <style>
        :root {
            --primary-color: @(ViewBag.ColorDefault ?? "#000000");
            --button-color: @(ViewBag.ColorButtons ?? "#4CAF50");
            --background-color: @(ViewBag.ColorBackground ?? "#ffffff");
            --font-family: '@ViewBag.FontName', 'Arial', @ViewBag.FontFamily;
            --logo-url: url('@(ViewBag.LogoDataUrl ?? "/images/default-logo.png")');
        }
    </style>

    <link rel="stylesheet" href="~/css/site.css" />

</head>
<body>
    @* ✅ HEADER *@
    @if (ViewBag.HideHeader != true)
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3">
                <div class="container-fluid">
                    @if (ViewData["Page"] == "Order overview" || ViewData["Page"] == "History")
                    {
                        <a class="navbar-brand mx-auto position-absolute start-0" asp-area="" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-caret-left" style="font-size: 35px; color: var(--primary-color);"></i>



                        </a>
                    }

                    @if (ViewData["Page"] == "Order summary")
                    {
                        <a class="navbar-brand mx-auto position-absolute start-0" asp-area="" asp-controller="Cart" asp-action="OrderList">
                            <i class="bi bi-caret-left" style="font-size: 35px; color: var(--primary-color);"></i>



                        </a>
                    }

                    @if (ViewData["Page"] == "Index" || ViewData["Page"] == "Order Confirmation Page")
                    {
                        @*  <a class="navbar-brand mx-auto position-absolute start-0" asp-area="" asp-controller="History" asp-action="History">
                <i class="bi bi-receipt-cutoff"
                style="font-size: 30px; color: var(--primary-color);"></i>
                </a> *@

                        @*    <div class= "navbar-brand mx-auto position-absolute start-0">
                <i class="bi bi-list menu-icon" id="menuToggle" data-bs-toggle="dropdown" aria-expanded="false" role="button" style="font-size: 30px;"></i>
                <ul class="dropdown-menu" aria-labelledby="menuToggle">
                <li><a class="dropdown-item" asp-area="" asp-controller="History" asp-action="History">History</a></li>
                <li><a class="dropdown-item" asp-controller="BusinessAccount" asp-action="Login">Staff Login</a></li>
                </ul>
                </div> *@

                        <div class="dropdown position-relative">
                            <i class="bi bi-list menu-icon" style="font-size: 35px; color: var(--primary-color)" id="menuToggle" data-bs-toggle="dropdown" aria-expanded="false" role="button"></i>

                            <ul class="dropdown-menu dropdown-menu-custom" aria-labelledby="menuToggle">
                                <li><a class="dropdown-item" asp-area="" asp-controller="History" asp-action="History">Order History</a></li>
                                <li><a class="dropdown-item" asp-controller="BusinessAccount" asp-action="Login">Staff Login</a></li>
                            </ul>
                        </div>


                    }

                    <a class="navbar-brand mx-auto" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="@ViewBag.LogoDataUrl" alt="Restaurant Logo" style="height:50px;">
                    </a>

                    <a class="cart position-relative" asp-area="" asp-controller="Cart" asp-action="OrderList">
                        <i class="bi bi-cart3" style="font-size: 30px; color: var(--primary-color);"></i>
                        @if (TempData["CartCount"] != null && int.TryParse(TempData["CartCount"].ToString(), out int cartCount) && cartCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill">
                                @cartCount
                                <span class="visually-hidden">Items in cart</span>
                            </span>
                        }
                    </a>

                    <!-- Add Staff Login Link to Footer -->
                    @* <div class="ms-auto">
                <a asp-controller="BusinessAccount" asp-action="Login" class="nav-link">Staff Login</a>
                </div> *@
                </div>
            </nav>
        </header>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* ✅ FOOTER *@
    @*  @if (ViewBag.HideFooter != true)
    {
    <footer class="custom-footer d-flex justify-content-around align-items-center">
    <button type="button" class="btn footer-btn"></button>
    <button type="button" class="btn footer-btn"></button>
    <button type="button" class="btn footer-btn">
    <i class="fas fa-home"></i>
    </button>
    </footer>
    }  *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.2"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>