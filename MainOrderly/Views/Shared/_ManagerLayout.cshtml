                    <li class="d-none d-sm-inline-block">
                        <div class="nav-link waves-effect waves-light" id="light-dark-mode" style="cursor: pointer;">
                            🌙
                        </div>
                    </li>

                    <!-- Bootstrap Icons CDN (make sure to include this in <head>) -->


                    <li class="nav-item dropdown">
                        <a class="nav-link position-relative" href="#" id="notificationDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-bell fs-4 text-light"></i>

                            <!-- Notification Badge -->
                            <span id="notificationCount"
                                  class="position-absolute badge rounded-pill bg-danger badge-pulse"
                                  style="top: 4px; right: 0px; transform: translate(50%, 0); font-size: 0.7rem; padding: 3px 6px; z-index: 10;">
                                    7
                                </span>

                        </a>
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-lg py-0 shadow-lg"
                             aria-labelledby="notificationDropdown" style="width: 360px;">
                            <div class="d-flex justify-content-between align-items-center border-bottom px-3 py-2 bg-light">
                                <h6 class="mb-0 fw-semibold">Notifications</h6>

                            </div>
                            <div id="notificationList" class="overflow-auto" style="max-height: 400px;">
                                <!-- Example notification item -->
                                <div class="d-flex px-3 py-2 border-bottom hover-bg">
                                    <div class="flex-shrink-0 text-primary me-2">
                                        <i class="bi bi-info-circle-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between">
                                            <p class="mb-1 fw-medium">System Update</p>
                                            <small class="text-muted">2 min ago</small>
                                        </div>
                                        <p class="small mb-0">Scheduled maintenance tonight at 11 PM</p>
                                    </div>
                                </div>
                                <!-- Empty state -->
                                <div class="text-center py-4 d-none" id="emptyNotifications">
                                    <i class="bi bi-bell-slash fs-2 text-muted"></i>
                                    <p class="text-muted mb-0">No new notifications</p>
                                </div>
                            </div>
                            <div class="text-center border-top py-2">
