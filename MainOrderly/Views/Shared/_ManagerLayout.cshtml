            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-6">
                        <div><script>document.write(new Date().getFullYear())</script> © Restaurant Management System - <a href="javascript:void(0);" target="_blank">Group-2</a></div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-none d-md-flex gap-4 align-item-center justify-content-md-end footer-links">
                            <a href="javascript: void(0);">About</a>
                            <a href="javascript: void(0);">Support</a>
                            <a href="javascript: void(0);">Contact Us</a>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
        <!-- end Footer -->
    </div>
    <!-- ============================================================== -->
    <!-- End Page content -->
    <!-- ============================================================== -->
</div>
<!-- END wrapper -->
<!-- Vendor js -->
<script src="~/assets/js/vendor.min.js"></script>

<!-- App js -->
<script src="~/assets/js/app.min.js"></script>

<!-- Plugins js-->
<script src="~/assets/libs/flatpickr/flatpickr.min.js"></script>
<script src="~/assets/libs/selectize/js/standalone/selectize.min.js"></script>

<!-- Dashboard init js-->
<script src="~/assets/js/pages/dashboard-1.init.js"></script>

<!-- Dark mode toggle -->
<script>
    const toggle = document.getElementById('light-dark-mode');
    let dark = false;
    toggle.onclick = () => {
        dark = !dark;
        toggle.innerText = dark ? '☀️' : '🌙';
        document.body.classList.toggle('dark-mode', dark);
    };
</script>

<script>
    function loadNotifications() {
        fetch("/Manager/GetNotifications")
            .then(res => res.json())
            .then(data => {
                const list = document.getElementById("notificationList");
                const count = document.getElementById("notificationCount");

                list.innerHTML = "";
                count.textContent = data.length;

                if (data.length === 0) {
                    count.style.display = "none";
                    list.innerHTML = "<p class='text-muted'>No alerts 🎉</p>";
                    return;
                }

                count.style.display = "inline-block";

                data.forEach(n => {
                    const item = document.createElement("a");
                    item.classList.add("dropdown-item", "text-wrap");
                    item.href = n.link;
                    item.innerHTML = `<strong>${n.title}</strong><br/><small class="text-muted">${n.time}</small>`;
                    list.appendChild(item);
                });
            })
            .catch(err => {
                console.error("❌ Notification error:", err);
                document.getElementById("notificationList").innerHTML = "<p class='text-danger'>Failed to load</p>";
            });
    }

    document.addEventListener("DOMContentLoaded", () => {
        loadNotifications();
        setInterval(loadNotifications, 60000); // Refresh every 60 sec
    });
</script>

@RenderSection("Scripts", required: false)

</body>
</html>