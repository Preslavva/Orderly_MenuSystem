    <script>
        const toggle = document.getElementById('light-dark-mode');

        let dark = false;
        toggle.onclick = () => {
            dark = !dark;
            toggle.innerText = dark ? '☀️' : '🌙';
            document.body.classList.toggle('dark-mode', dark);
        };
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            fetch("/Manager/GetNotifications")
                .then(resp => resp.json())
                .then(data => {
                    const list = document.getElementById("notification-list");
                    const count = document.getElementById("notification-count");
                    list.innerHTML = "";

                    if (data.length === 0) {
                        list.innerHTML = '<li class="p-3 text-center text-muted">No new notifications</li>';
                        count.style.display = "none";
                        return;
                    }

                    count.textContent = data.length;
                    count.style.display = "inline-block";

                    data.forEach(notif => {
                        list.innerHTML += `
                            <li class="border-bottom p-3">
                                <div><strong>${notif.title}</strong></div>
                                <div class="small text-muted">${notif.time}</div>
                                <a href="${notif.link}" class="btn btn-sm btn-outline-primary mt-1">View</a>
                            </li>
                        `;
                    });
                })
                .catch(err => {
                    console.error("Failed to load notifications:", err);
                });
        });
    </script>

