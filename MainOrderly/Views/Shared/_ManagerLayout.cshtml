                @if (user != null && (user.Roles.Contains("Owner") || user.Roles.Contains("Manager")))
                {
                    <li class="menu-item">
                        <a href="index.html#menuEcommerce" data-bs-toggle="collapse" class="menu-link">
                            <span class="menu-icon"><i data-feather="book-open"></i></span>
                            <span class="menu-text">Menu Management</span>
