                            <i data-feather="chevron-down" class="menu-arrow"></i>
                        </a>
                        <div class="collapse" id="menuProjects">
                            <ul class="sub-menu">
                                <li class="menu-item">
                                    <a href="@Url.Action("AddIngredient", "Manager")" class="menu-link">
                                        <span class="menu-text">Add</span>
                                    </a>
                                </li>
                                <li class="menu-item">
                                    <a href="@Url.Action("IngredientList", "Manager")" class="menu-link">
                                        <span class="menu-text">List</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li class="menu-item">
                        <a href="index.html#menuTable" data-bs-toggle="collapse" class="menu-link">
                            <span class="menu-icon"><i data-feather="grid"></i></span>
                            <span class="menu-text">Table Management</span>
                            <i data-feather="chevron-down" class="menu-arrow"></i>
                        </a>
                        <div class="collapse" id="menuTable">
                            <ul class="sub-menu">
                                <li class="menu-item">
                                    <a href="@Url.Action("AddTable", "Manager")" class="menu-link">
                                        <span class="menu-text">Add Table</span>
                                    </a>
                                </li>
                                <li class="menu-item">
                                    <a href="@Url.Action("TableList", "Manager")" class="menu-link">
                                        <span class="menu-text">List of Tables</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>

                    <li class="menu-item">
                        <a href="index.html#menuAnalytics" data-bs-toggle="collapse" class="menu-link">
                            <span class="menu-icon"><i data-feather="bar-chart-2"></i></span>
                            <span class="menu-text">Analytics</span>
                            <i data-feather="chevron-down" class="menu-arrow"></i>
                        </a>
                        <div class="collapse" id="menuAnalytics">
                            <ul class="sub-menu">
                                <li class="menu-item">
                                    <a href="@Url.Action("TotalRevenue", "Analytics")" class="menu-link">
                                        <span class="menu-text">Total Revenue</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </li>
                }

                @if (user != null && (user.Roles.Contains("Owner") || user.Roles.Contains("Manager") || user.Roles.Contains("Chef")))
                {
                    <li class="menu-item">
                        <a href="@Url.Action("Dashboard", "Kitchen")" class="menu-link">
                            <span class="menu-icon"><i data-feather="clock"></i></span>
                            <span class="menu-text">Kitchen Dashboard</span>
                        </a>
                    </li>
                }

                @if (user != null && (user.Roles.Contains("Owner") || user.Roles.Contains("Manager") || user.Roles.Contains("Waiter")))
                {
                    <li class="menu-item">
                        <a href="@Url.Action("Orders", "Waiter")" class="menu-link">
