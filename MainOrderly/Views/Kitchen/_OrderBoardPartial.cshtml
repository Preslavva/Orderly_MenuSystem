 @model CompositeKitchenViewModel

<!-- Column for NEW orders -->
<div class="order-column">
    <h3 class="column-header new-orders-header">New Orders</h3>
    @if (Model.NewOrders != null && Model.NewOrders.Any())
    {
        var ordersByTable = Model.NewOrders.GroupBy(o => o.Table);

        @foreach (var tableGroup in ordersByTable)
        {
            <div class="order-card">
                <div class="order-header">
                    <div class="order-table">Table @tableGroup.Key</div>
                    <div class="order-count">@tableGroup.Count() orders</div>
                </div>
                <div class="order-content">
                    @foreach (var orderViewModel in tableGroup)
                    {
                        <div class="order-subcard">
                            <div class="order-subheader">
                                <div class="order-id">Order #@orderViewModel.Id</div>
                                <div class="order-timestamp">
                                    @orderViewModel.OrderTimestamp.ToString("HH:mm")
                                </div>
                            </div>

                            @if (orderViewModel.Items != null && orderViewModel.Items.Count > 0)
                            {
                                <ul class="order-items">
                                    @foreach (var item in orderViewModel.Items)
                                    {
                                        <li class="order-item">
                                            <span class="item-quantity">@item.Quantity×</span>
                                            <span class="item-name">@item.Name</span>
                                        </li>
                                    }
                                </ul>
                            }
                            <div class="order-actions">
                                <form method="post" asp-action="UpdateOrderStatus"
                                    hx-post="@Url.Action("UpdateOrderStatus", "Kitchen")"
                                    hx-target="#order-board"
                                    hx-swap="innerHTML">
                                    <input type="hidden" name="id" value="@orderViewModel.Id" />
                                    <input type="hidden" name="newStatus" value="@OrderStatus.PROCESSING" />
                                    <button type="submit" class="btn btn-primary btn-move-process">Start Processing</button>
                                </form>
                            </div>
                        </div>

                        @if (tableGroup.Last() != orderViewModel)
                        {
                            <hr class="order-divider" />
                        }
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-orders">No new orders at this time</div>
    }
</div>


<!-- Column for PROCESSING orders -->
<div class="order-column">
    <h3 class="column-header processing-orders-header">Processing Orders</h3>
    @if (Model.PendingOrders != null && Model.PendingOrders.Any())
    {
        
        var ordersByTable = Model.PendingOrders.GroupBy(o => o.Table);

        @foreach (var tableGroup in ordersByTable)
        {
            <div class="order-card">
                <div class="order-header">
                    <div class="order-table">Table @tableGroup.Key</div>
                    <div class="order-count">@tableGroup.Count() order(s)</div>
                </div>
                <div class="order-content">
                    @foreach (var orderViewModel in tableGroup)
                    {
                        <div class="order-subcard">
                            <div class="order-subheader">
                                <div class="order-id">Order #@orderViewModel.Id</div>
                                <div class="order-timestamp">
                                    @orderViewModel.OrderTimestamp.ToString("HH:mm")
                                </div>
                            </div>

                            @if (orderViewModel.Items != null && orderViewModel.Items.Count > 0)
                            {
                                <ul class="order-items">
                                    @foreach (var item in orderViewModel.Items)
                                    {
                                        <li class="order-item">
                                            <span class="item-quantity">@item.Quantity×</span>
                                            <span class="item-name">@item.Name</span>
                                        </li>
                                    }
                                </ul>
                            }

                            <div class="order-actions">
                                <form method="post" asp-action="UpdateOrderStatus"
                                    hx-post="@Url.Action("UpdateOrderStatus", "Kitchen")"
                                    hx-target="#order-board"
                                    hx-swap="innerHTML">
                                    <input type="hidden" name="id" value="@orderViewModel.Id" />
                                    <input type="hidden" name="newStatus" value="@OrderStatus.COMPLETED" />
                                    <button type="submit" class="btn btn-primary btn-move-process">Mark as ready</button>
                                </form>
                            </div>
                        </div>

                        @if (tableGroup.Last() != orderViewModel)
                        {
                            <hr class="order-divider" />
                        }
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-orders">No orders in process</div>
    }
</div>

<!-- Column for COMPLETED orders -->
<div class="order-column">
    <h3 class="column-header completed-orders-header">Completed Orders</h3>
    @if (Model.CompletedOrders != null && Model.CompletedOrders.Any())
    {
        // Group orders by table
        var ordersByTable = Model.CompletedOrders.GroupBy(o => o.Table);

        @foreach (var tableGroup in ordersByTable)
        {
            <div class="order-card">
                <div class="order-header">
                    <div class="order-table">Table @tableGroup.Key</div>
                    <div class="order-count">@tableGroup.Count() order(s)</div>
                </div>
                <div class="order-content">
                    @foreach (var orderViewModel in tableGroup)
                    {
                        <div class="order-subcard">
                            <div class="order-subheader">
                                <div class="order-id">Order #@orderViewModel.Id</div>
                                <div class="order-timestamp">
                                    @orderViewModel.OrderTimestamp.ToString("HH:mm")
                                </div>
                            </div>

                            @if (orderViewModel.Items != null && orderViewModel.Items.Count > 0)
                            {
                                <ul class="order-items">
                                    @foreach (var item in orderViewModel.Items)
                                    {
                                        <li class="order-item">
                                            <span class="item-quantity">@item.Quantity×</span>
                                            <span class="item-name">@item.Name</span>
                                        </li>
                                    }
                                </ul>
                            }

                            <div class="status-pill status-completed">Ready for service</div>
                        </div>

                        @if (tableGroup.Last() != orderViewModel)
                        {
                            <hr class="order-divider" />
                        }
                    }

                    <div class="order-actions table-actions">
                        <form asp-controller="Kitchen" asp-action="RemoveOrderDashboard" method="post"
                              hx-post="@Url.Action("RemoveOrderDashboard", "Kitchen")"
                              hx-target="#order-board"
                              hx-swap="innerHTML">             
                            @foreach (var order in tableGroup)
                            {
                                <input type="hidden" name="id" value="@order.Id" />
                            }
                            <button type="submit" class="btn btn-secondary btn-remove">Remove All</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-orders">No completed orders</div>
    }
</div>
