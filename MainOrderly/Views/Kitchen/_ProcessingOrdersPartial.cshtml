@using Models.Enums
@inject MainOrderly.WebApp.Helpers.TimerHelpers Timer
@model KitchenViewModelWithTimer

<h3 class="column-header processing-orders-header">Processing Orders</h3>

@if (Model.CompositeKitchenViewModel.PendingOrders?.Any() == true)
{
    var tables = Model.CompositeKitchenViewModel.PendingOrders.GroupBy(i => i.Table);

    foreach (var tableGroup in tables)
    {
        <div class="table-card">
            <div class="table-header">
                <span class="table-name">Table @tableGroup.Key</span>
                <span class="order-count">
                    @tableGroup.Select(i => i.OrderId).Distinct().Count() order(s)
                </span>
            </div>

            @foreach (var orderGroup in tableGroup.GroupBy(i => i.OrderId))
            {
                /* one countdown per order */
                
                    int    secRemain;
                    string clock   = Timer.GetRemainingTime(orderGroup.Key, out secRemain);
                    bool   overdue = secRemain == 0;

                    var items         = orderGroup.OrderByDescending(i => i.PrepTime).ToList();
                    int longestItemId = items.First().MenuItemId;
               

                <div class="order-row">
                    <div class="order-header">
                        <span class="order-id">Order #@orderGroup.Key</span>
                        <span class="order-time">@orderGroup.First().OrderTimestamp</span>
                    </div>

                    @foreach (var item in items)
                    {
                            bool cookFirst   = item.MenuItemId == longestItemId;
                            bool shouldStart = secRemain <= item.PrepTime * 60 &&
                                               item.Status == OrderStatus.PROCESSING;


                            int itemDelayStart = (item.PrepTime * 60); // seconds
                            bool cookFirstWindow = secRemain >= itemDelayStart - 4 && cookFirst; // fade after 4s
                            bool startNowWindow = secRemain <= itemDelayStart && secRemain >= itemDelayStart - 3 && shouldStart; // fade after 3s

                        <div class="menu-item-row">
                            <div class="item-details">
                                <span class="item-quantity">@item.Quantity×</span>
                                <span class="item-name">@item.Name</span>
                            </div>

                            <div class="item-actions">
                                @if (cookFirstWindow)
                                {
                                    <span class="badge badge-cookfirst me-2">Cook first</span>
                                }
                                else if (startNowWindow)
                                {
                                    <span class="badge badge-startnow me-2">Start now</span>
                                }

                                <form asp-action="UpdateOrderItemStatus"
                                      method="post"
                                      hx-post='@Url.Action("UpdateOrderItemStatus","Kitchen")'
                                      hx-target="#processing-orders-column"
                                      hx-swap="innerHTML">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId"    value="@item.OrderId" />
                                    <input type="hidden" name="menuItemId" value="@item.MenuItemId" />
                                    <input type="hidden" name="newStatus"  value="@OrderStatus.COMPLETED" />
                                    <button class="btn-arrow" title="Mark ready">
                                        <i class="bi bi-arrow-right-circle fs-5"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }

                    <div class="item-timer @(overdue ? "timer-exceeded" : "")">@clock</div>
                </div>

                @if (orderGroup != tableGroup.GroupBy(i => i.OrderId).Last())
                {
                    <hr class="separator" />
                }
            }
        </div>
    }
}
else
{
    <div class="empty-message">No orders in process</div>
}

<style>
  
    .menu-item-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-bottom: .5rem;
        background: #f8f9fa;
        border-radius: 4px;
        padding: .5rem .75rem;
    }

    .item-actions {
        display: flex;
        align-items: center;
    }

    .btn-arrow {
        background: none;
        border: none;
        padding: 0;
        color: #2564ff; /* blue arrow */
    }

        .btn-arrow:hover {
            opacity: .7;
        }

    .item-timer {
        font-family: monospace;
        font-size: 1.6rem;
        font-weight: 700;
        padding: .3rem .8rem;
        background: #f1f1f1;
        border-radius: 6px;
        width: max-content;
        margin-top: .5rem;
    }

    .timer-exceeded {
        background: #dc3545;
        color: #fff;
        animation: alarm-pulse 1s infinite;
    }

</style>
