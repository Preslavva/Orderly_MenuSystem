@model KitchenViewModelWithTimer

<h3 class="column-header completed-orders-header">Completed Orders</h3>

@if (Model.CompositeKitchenViewModel.CompletedOrders?.Any() == true)
{
    /* first group by table, then by order */
    var tables = Model.CompositeKitchenViewModel.CompletedOrders.GroupBy(i => i.Table);

    foreach (var tableGroup in tables)
    {
        <div class="table-card">
            <div class="table-header">
                <span class="table-name">Table @tableGroup.Key</span>
                <span class="order-count">
                    @tableGroup.Select(i => i.OrderId).Distinct().Count() order(s)
                </span>
            </div>

            
            @foreach (var orderGroup in tableGroup.GroupBy(i => i.OrderId))
            {
            <div class="order-row">
                <div class="order-header">
                    <span class="order-id">Order #@orderGroup.Key</span>
                    <span class="order-time">@orderGroup.First().ElapsedTime</span>
                </div>

                @foreach (var item in orderGroup)
                {
                    <div class="menu-item-row">
                        <div class="item-details">
                            <span class="item-quantity">@item.Quantity×</span>
                            <span class="item-name">@item.Name</span>
                        </div>
                    </div>
                }

                <div class="status-badge">Ready for service</div>
            </div>

            @if (!orderGroup.Equals(tableGroup.Last()))
            {
                <hr class="separator" />
            }
            }

            <div class="table-actions">
                <form asp-controller="Kitchen"
                      asp-action="RemoveOrderDashboard"
                      hx-post="@Url.Action("RemoveOrderDashboard", "Kitchen")"
                      hx-target="#completed-orders-column"
                      hx-swap="innerHTML"
                      method="post">
                    @foreach (var id in tableGroup.Select(i => i.OrderId).Distinct())
                    {
                        <input type="hidden" name="id" value="@id" />
                    }
                    <button type="submit" class="btn btn-secondary">Remove All</button>
                </form>
            </div>
        </div>
    }
}
else
{
    <div class="empty-message">No completed orders</div>
}
