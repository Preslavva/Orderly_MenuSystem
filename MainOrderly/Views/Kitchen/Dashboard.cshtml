@model CompositeKitchenViewModel

@{
    ViewData["Title"] = "Kitchen Orders Dashboard";
}
<h2>Kitchen Orders</h2>
<meta http-equiv="refresh" content="1">
<div class="row">
    <!-- Column for NEW orders -->
    <div class="col-md-4">
        <h3 style="border-bottom: 3px solid red;">New Orders</h3>
        @foreach (OrderViewModel orderViewModel in Model.NewOrders)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5>Order @orderViewModel.Id</h5>
                    <p>Table: @orderViewModel.Table.</p>
                    <p>Ordered At: @orderViewModel.OrderTimestamp</p>

                    @* @if (order.Items != null && order.Items.Count > 0) *@
                    @* { *@
                    @*     <ul> *@
                    @*         @foreach (var item in order.Items) *@
                    @*         { *@
                    @*             <li>@item.Name (@item.Quantity)</li> *@
                    @*         } *@
                    @*     </ul> *@
                    @* } *@

                    <!-- Form to move order to 'Processing' -->
                    <form method="post" asp-action="UpdateOrderStatus">
                        <input type="hidden" name="id" value="@orderViewModel.Id" />
                        <input type="hidden" name="newStatus" value="@OrderStatus.PROCESSING" />
                        <button type="submit" class="btn btn-primary">Move to Process</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- Column for PROCESSING orders -->
    <div class="col-md-4">
        <h3 style="border-bottom: 3px solid orange;">Processing Orders</h3>
        @foreach (OrderViewModel orderViewModel in Model.PendingOrders)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5>Order @orderViewModel.Id</h5>
                    <p>Table: @orderViewModel.Table</p>
                    <p>Ordered At: @orderViewModel.OrderTimestamp</p>

                    @* @if (order.Items != null && order.Items.Count > 0) *@
                    @* { *@
                    @*     <ul> *@
                    @*         @foreach (var item in order.Items) *@
                    @*         { *@
                    @*             <li>@item.Name (@item.Quantity)</li> *@
                    @*         } *@
                    @*     </ul> *@
                    @* } *@

                    <!-- Form to move order to 'Completed' -->
                    <form method="post" asp-action="UpdateOrderStatus">
                        <input type="hidden" name="id" value="@orderViewModel.Id" />
                        <input type="hidden" name="newStatus" value="@OrderStatus.COMPLETED" />
                        <button type="submit" class="btn btn-success">Move to Ready</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- Column for COMPLETED orders -->
    <div class="col-md-4">
        <h3 style="border-bottom: 3px solid green;">Completed Orders</h3>
        @foreach (OrderViewModel orderViewModel in Model.CompletedOrders)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5>Order @orderViewModel.Id</h5>
                    <p>Table: @orderViewModel.Table</p>
                    <p>Ordered At: @orderViewModel.OrderTimestamp</p>

                    @* @if (order.Items != null && order.Items.Count > 0) *@
                    @* { *@
                    @*     <ul> *@
                    @*         @foreach (var item in order.Items) *@
                    @*         { *@
                    @*             <li>@item.Name (@item.Quantity)</li> *@
                    @*         } *@
                    @*     </ul> *@
                    @* } *@

                    <p><em>Order is completed</em></p>
                    <form asp-controller="Kitchen" asp-action="RemoveOrderDashboard" method="post">
                         <input type="hidden" name="id" value="@orderViewModel.Id" />
                        <button type="submit" class="btn btn-primary">Remove</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
