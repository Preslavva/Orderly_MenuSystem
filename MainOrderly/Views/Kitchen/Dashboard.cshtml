@model KitchenViewModelWithTimer
@{
	ViewData["Title"] = "Kitchen Orders Dashboard";
	Layout = "_KitchenStaffLayout";
}

<div class="order-board">

	<div id="new-orders-column" class="order-column"
	     hx-get="@Url.Action("GetNewOrders", "Kitchen")"
	     hx-trigger="every 2s"
	     hx-swap="innerHTML">
		@await Html.PartialAsync("_NewOrdersPartial", Model)
	</div>

	<div id="processing-orders-column" class="order-column"
	     hx-get="@Url.Action("GetProcessingOrders", "Kitchen")"
	     hx-trigger="every 1s"
	     hx-swap="innerHTML">
		@await Html.PartialAsync("_ProcessingOrdersPartial", Model)
	</div>

	<div id="completed-orders-column" class="order-column"
	     hx-get="@Url.Action("GetCompletedOrders", "Kitchen")"
	     hx-trigger="every 2s"
	     hx-swap="innerHTML">
		@await Html.PartialAsync("_CompletedOrdersPartial", Model)
	</div>
</div>

