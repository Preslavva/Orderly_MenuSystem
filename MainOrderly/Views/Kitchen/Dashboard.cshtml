@model CompositeKitchenViewModel

@{
    ViewData["Title"] = "Kitchen Orders Dashboard";
    Layout = "_KitchenStaffLayout";
}


<div id="order-board" class="order-board"
     hx-get="@Url.Action("GetUpdatedOrders", "Kitchen")"
     hx-trigger="every 4s"
     hx-swap="innerHTML">

    @await Html.PartialAsync("_OrderBoardPartial", Model)
</div>  