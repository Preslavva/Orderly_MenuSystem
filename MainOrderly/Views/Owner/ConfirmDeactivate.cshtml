@model Models.Entities.Restaurant
@{
    ViewData["Title"] = "Confirm Restaurant Deactivation";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="container-fluid">
    <!-- Page Title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Owner")">Company Details</a></li>
                        <li class="breadcrumb-item active">Confirm Deactivation</li>
                    </ol>
                </div>
                <h4 class="page-title text-danger">Confirm Restaurant Deactivation</h4>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-danger">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="dripicons-warning text-danger" style="font-size: 4rem;"></i>
                        <h2 class="text-danger mt-3">Are you absolutely sure?</h2>
                        <p class="text-muted fs-5">This action cannot be undone and will have serious consequences.</p>
                    </div>

                    <div class="alert alert-danger" role="alert">
                        <h5 class="alert-heading">
                            <i class="dripicons-warning me-2"></i>What will happen:
                        </h5>
                        <ul class="mb-0">
                            <li><strong>Your restaurant "@Model.Name" will be immediately deactivated</strong></li>
                            <li>All staff members will lose access to the system</li>
                            <li>Customers will no longer be able to place orders</li>
                            <li>All QR codes for tables will stop working</li>
                            <li>You will be automatically logged out of the system</li>
                            <li>All ongoing orders will need to be handled manually</li>
                        </ul>
                    </div>

                    <div class="row justify-content-center">
                        <div class="col-md-8">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="header-title">Restaurant Information</h5>
                                    <div class="table-responsive">
                                        <table class="table table-borderless table-sm mb-0">
                                            <tr>
                                                <td><strong>Name:</strong></td>
                                                <td>@Model.Name</td>
                                            </tr>
                                            <tr>
                                                <td><strong>KVK:</strong></td>
                                                <td>@Model.KVK</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Address:</strong></td>
                                                <td>@Model.Address</td>
                                            </tr>
                                            <tr>
                                                <td><strong>Status:</strong></td>
                                                <td>
                                                    @if (Model.IsActive)
                                                    {
                                                        <span class="badge bg-success">Currently Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger">Currently Inactive</span>
                                                    }
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 p-3 bg-light rounded">
                        <h6 class="text-danger">To confirm deactivation, please type your restaurant name below:</h6>
                        <div class="row align-items-end">
                            <div class="col-md-8">
                                <input type="text" id="confirmationInput" class="form-control"
                                       placeholder="Type '@Model.Name' to confirm" />
                                <small class="form-text text-muted">
                                    This is to ensure you really want to deactivate your restaurant.
                                </small>
                            </div>
                            <div class="col-md-4">
                                <form asp-action="DeactivateRestaurant" method="post" style="display: inline;">
                                    <button type="submit" id="confirmDeactivateBtn" class="btn btn-danger w-100" disabled>
                                        <i class="mdi mdi-delete"></i> Yes, Deactivate Restaurant
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <a href="@Url.Action("Dashboard", "Owner")" class="btn btn-secondary btn-lg">
                            <i class="dripicons-arrow-left"></i> Cancel - Keep Restaurant Active
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('confirmationInput').addEventListener('input', function() {
            const input = this.value.trim();
            const expectedName = '@Model.Name';
            const button = document.getElementById('confirmDeactivateBtn');

            if (input === expectedName) {
                button.disabled = false;
                button.classList.remove('btn-secondary');
                button.classList.add('btn-danger');
            } else {
                button.disabled = true;
                button.classList.remove('btn-danger');
                button.classList.add('btn-secondary');
            }
        });

        // Add extra confirmation
        document.querySelector('form').addEventListener('submit', function(e) {
            if (!confirm('This is your final warning! Are you absolutely sure you want to deactivate your restaurant? This action cannot be undone.')) {
                e.preventDefault();
            }
        });
    </script>
}