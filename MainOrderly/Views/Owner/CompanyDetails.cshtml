@model MainOrderly.WebApp.ViewModels.OwnerDashboardViewModel
@{
    ViewData["Title"] = "Company Details";
    Layout = "~/Views/Shared/_ManagerLayout.cshtml";
}

<div class="container-fluid">
    <!-- Page Title -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box">
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="javascript: void(0);">Dashboard</a></li>
                        <li class="breadcrumb-item active">Company Details</li>
                    </ol>
                </div>
                <h4 class="page-title">Company Details</h4>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="dripicons-checkmark me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="dripicons-warning me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Quick Stats Row -->
    <div class="row">
        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card tilebox-one">
                <div class="card-body">
                    <i class="dripicons-shop float-end text-muted"></i>
                    <h6 class="text-muted text-uppercase mt-0">Restaurant Status</h6>
                    <h2 class="m-b-20">
                        @if (Model.Restaurant.IsActive)
                        {
                            <span class="badge bg-success fs-6">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">Inactive</span>
                        }
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card tilebox-one">
                <div class="card-body">
                    <i class="dripicons-card float-end text-muted"></i>
                    <h6 class="text-muted text-uppercase mt-0">KVK Number</h6>
                    <h2 class="m-b-20 fs-4">@Model.Restaurant.KVK</h2>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card tilebox-one">
                <div class="card-body">
                    <i class="dripicons-user float-end text-muted"></i>
                    <h6 class="text-muted text-uppercase mt-0">Owner</h6>
                    <h2 class="m-b-20 fs-5">@Model.Owner.FirstName @Model.Owner.LastName</h2>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-lg-6 col-md-6">
            <div class="card tilebox-one">
                <div class="card-body">
                    <i class="dripicons-calendar float-end text-muted"></i>
                    <h6 class="text-muted text-uppercase mt-0">Last Updated</h6>
                    <h2 class="m-b-20 fs-6">Today</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row">
        <!-- Restaurant Information Card -->
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <div class="dropdown float-end">
                        <a href="#" class="dropdown-toggle arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="dripicons-dots-3"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a href="@Url.Action("EditRestaurant", "Owner")" class="dropdown-item">
                                <i class="mdi mdi-pencil me-1"></i>Edit Restaurant
                            </a>
                        </div>
                    </div>
                    <h4 class="header-title mb-3">
                        <i class="dripicons-shop me-2"></i>Restaurant Information
                    </h4>

                    <div class="table-responsive">
                        <table class="table table-borderless table-sm mb-0">
                            <tbody>
                                <tr>
                                    <td class="fw-semibold" style="width: 35%;">Restaurant Name:</td>
                                    <td>@Model.Restaurant.Name</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Email:</td>
                                    <td>@Model.Restaurant.Email</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Phone:</td>
                                    <td>@Model.Restaurant.PhoneNumber</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Address:</td>
                                    <td>@Model.Restaurant.Address</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">KVK Number:</td>
                                    <td><span class="badge bg-primary">@Model.Restaurant.KVK</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Status:</td>
                                    <td>
                                        @if (Model.Restaurant.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Description:</td>
                                    <td>@(Model.Restaurant.Description ?? "No description provided")</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <a href="@Url.Action("EditRestaurant", "Owner")" class="btn btn-sm btn-primary">
                            <i class="mdi mdi-pencil"></i> Edit Restaurant Information
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Owner Profile Card -->
        <div class="col-lg-6">
            <div class="card">
                <div class="card-body">
                    <div class="dropdown float-end">
                        <a href="#" class="dropdown-toggle arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="dripicons-dots-3"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a href="@Url.Action("EditProfile", "Owner")" class="dropdown-item">
                                <i class="mdi mdi-pencil me-1"></i>Edit Profile
                            </a>
                        </div>
                    </div>
                    <h4 class="header-title mb-3">
                        <i class="dripicons-user me-2"></i>Your Profile
                    </h4>

                    <div class="table-responsive">
                        <table class="table table-borderless table-sm mb-0">
                            <tbody>
                                <tr>
                                    <td class="fw-semibold" style="width: 35%;">First Name:</td>
                                    <td>@Model.Owner.FirstName</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Last Name:</td>
                                    <td>@Model.Owner.LastName</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Full Name:</td>
                                    <td><strong>@Model.Owner.FirstName @Model.Owner.LastName</strong></td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Email:</td>
                                    <td>@Model.Owner.Email</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Phone:</td>
                                    <td>@Model.Owner.Phone</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Role:</td>
                                    <td><span class="badge bg-warning">Owner</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3">
                        <a href="@Url.Action("EditProfile", "Owner")" class="btn btn-sm btn-primary">
                            <i class="mdi mdi-pencil"></i> Edit Your Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Danger Zone -->
    <div class="row">
        <div class="col-12">
            <div class="card border-danger">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="dripicons-warning text-danger" style="font-size: 2rem;"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h4 class="text-danger mb-1">Danger Zone</h4>
                            <p class="text-muted mb-0">
                                Once you deactivate your restaurant, it will no longer be accessible to customers and staff. 
                                This action will log you out and disable all restaurant operations.
                            </p>
                        </div>
                        <div class="flex-shrink-0">
                            <a href="@Url.Action("ConfirmDeactivate", "Owner")" class="btn btn-danger">
                                <i class="mdi mdi-delete"></i> Deactivate Restaurant
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>