@model CreateMenuItemViewModel
@{

    ViewData["Title"] = "Menu Management";
    Layout = "_ManagerLayout";
}

<div class="content">

    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">

                    <h4 class="page-title">Add / Edit </h4>
                </div>
            </div>
        </div>
        <!-- end page title -->


        <form asp-action="Create" asp-controller="Manager" method="post" enctype="multipart/form-data">
            <!-- <-- зміни тут -->
            <div class="row">
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="text-uppercase bg-light p-2 mt-0 mb-3">General</h5>

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Price" class="form-label"></label>
                                <input asp-for="Price" class="form-control" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            @* <div class="mb-3">
                                <label asp-for="Quantity" class="form-label"></label>
                                <input asp-for="Quantity" class="form-control" />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div> *@
                            <div class="mb-3">
                                <label class="form-label">Allergens</label>
                                <div>
                                    @foreach (var allergen in Enum.GetValues(typeof(AllergenName)).Cast<AllergenName>())
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="SelectedAllergens"
                                                   value="@allergen"
                                            @(Model.SelectedAllergens.Contains(allergen) ? "checked" : "") />
                                            <label class="form-check-label">@allergen</label>
                                        </div>
                                    }
                                </div>
                            </div>


                            <div class="mb-3">
                                <label class="form-label">Nutrition Facts</label>
                                @foreach (var nutrition in Enum.GetValues(typeof(NutritionName)).Cast<NutritionName>())
                                {
                                    <div class="input-group mb-2">
                                        <span class="input-group-text">@nutrition</span>
                                        <input type="number" step="0.01" class="form-control" name="NutritionValues[@nutrition]" />
                                    </div>
                                }
                            </div>

                            <div class="mb-3">
                                <label asp-for="Category" class="form-label">Category</label>

                                <select asp-for="Category" asp-items="Html.GetEnumSelectList<Category>()" class="form-control">
                                    <option value="">Select</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="IsAvailable" class="form-check-input" />
                                <label asp-for="IsAvailable" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                </div> <!-- end col -->

                <div class="col-lg-6">

                    <div class="card">
                        <div class="card-body">
                            <h5 class="text-uppercase mt-0 mb-3 bg-light p-2">Product Images</h5>

                            <div class="mb-3">
                                <label class="form-label">Upload Image (max 2MB (1024X1024))</label>
                                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                                <span asp-validation-for="ImageFile" class="text-danger"></span>
                            </div>



                            <!-- Preview -->
                            <div class="dropzone-previews mt-3" id="file-previews"></div>
                        </div>
                    </div> <!-- end col-->


                </div> <!-- end col-->
            </div>
            <!-- end row -->
            @if (Model?.AvailableIngredients != null)
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Choose</th>
                            <th>Name</th>
                            <th>Stock</th>
                            <th>Quantity</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.AvailableIngredients.Count; i++)
                        {
                            var ingredient = Model.AvailableIngredients[i];
                            <tr>
                                <td>
                                    <input type="checkbox"
                                           name="SelectedIngredientIds"
                                           value="@ingredient.Id"
                                    @(Model.SelectedIngredientIds.Contains(ingredient.Id) ? "checked" : "") />
                                </td>
                                <td>@ingredient.Name</td>
                                <td>@ingredient.FormattedStock</td>
                                <td>
                                    <input type="number"
                                           name="IngredientQuantities[@ingredient.Id]"
                                           step="0.01"
                                           min="0"
                                           class="form-control"
                                           value="@(Model.IngredientQuantities.ContainsKey(ingredient.Id) ? Model.IngredientQuantities[ingredient.Id] : 0)" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }



            <div class="row">
                <a asp-action="MenuItems" class="btn btn-light">Cancel</a>

                <button type="submit" formaction="@Url.Action("Create", "Manager")" class="btn btn-success">Save</button>

                <button type="submit" formaction="@Url.Action("Delete", "Manager", new { id = Model.Id })" class="btn btn-danger">Delete</button>
            </div>
        </form>

        <!-- end row -->
        <!-- file preview template -->
        <div class="d-none" id="uploadPreviewTemplate">
            <div class="card mt-1 mb-0 shadow-none border">
                <div class="p-2">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <img data-dz-thumbnail src="ecommerce-product-edit.html#" class="avatar-sm rounded bg-light" alt="">
                        </div>
                        <div class="col ps-0">
                            <a href="javascript:void(0);" class="text-muted fw-bold" data-dz-name></a>
                            <p class="mb-0" data-dz-size></p>
                        </div>
                        <div class="col-auto">
                            <!-- Button -->
                            <a href="ecommerce-product-edit.html" class="btn btn-link btn-lg text-muted" data-dz-remove>
                                <i class="dripicons-cross"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div> <!-- container -->

</div> <!-- content -->

<script>
    document.querySelector('input[type="file"]').addEventListener('change', function (e) {
        const file = e.target.files[0];
        const preview = document.getElementById('file-previews');
        if (file && file.type.startsWith("image/")) {
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.innerHTML = `<img src="${e.target.result}" class="img-thumbnail mt-2" style="max-width: 200px;" />`;
            };
            reader.readAsDataURL(file);
        }
    });


     document.addEventListener("DOMContentLoaded", function () {
        // Attach input event listeners to all quantity inputs
        const quantityInputs = document.querySelectorAll("input[name^='IngredientQuantities']");

        quantityInputs.forEach(input => {
            input.addEventListener("input", function () {
                const ingredientId = input.name.match(/\d+/)[0]; // Extract ID from name
                const checkbox = document.querySelector(`input[type='checkbox'][value='${ingredientId}']`);

                if (checkbox) {
                    checkbox.checked = parseFloat(input.value) > 0;
                }
            });
        });
    });
</script>
