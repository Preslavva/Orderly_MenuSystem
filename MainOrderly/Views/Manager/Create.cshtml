@model CreateMenuItemViewModel
@{

    ViewData["Title"] = "Menu Management";
    Layout = "_ManagerLayout";
    ViewData["ButtonClass"] = "page-btn";
}

<div class="content">

    <!-- Start Content-->
    <div class="container-fluid">

        <!-- start page title -->
        <div class="row">
            <div class="col-12">
                <div class="page-title-box">

                    <h4 class="page-title">Add / Edit </h4>
                </div>
            </div>
        </div>
        <!-- end page title -->


        <form asp-action="Create" asp-controller="Manager" method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="text-uppercase bg-light p-2 mt-0 mb-3">General</h5>

                            <div class="mb-3">
                                <label asp-for="Name" class="form-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label"></label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Price" class="form-label"></label>
                                <input asp-for="Price" class="form-control" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>



                            <div class="mb-3">
                                <label class="form-label">Allergens</label>
                                <div>
                                    @foreach (var allergen in Enum.GetValues(typeof(AllergenName)).Cast<AllergenName>())
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="SelectedAllergens"
                                                   value="@allergen"
                                            @(Model.SelectedAllergens.Contains(allergen) ? "checked" : "") />
                                            <label class="form-check-label">@allergen</label>
                                        </div>
                                    }
                                </div>
                            </div>



                        </div>
                    </div>
                </div> <!-- end col -->

                <div class="col-lg-6">

                    <div class="card">
                        <div class="card-body">
                            <h5 class="text-uppercase mt-0 mb-3 bg-light p-2">Product Images</h5>

                            <div class="mb-3">
                                <label class="form-label">Upload Image (max 2MB (1024X1024))</label>
                                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                                <input type="hidden" asp-for="Picture" />
                                <span asp-validation-for="ImageFile" class="text-danger"></span>
                            </div>




                            <!-- Preview -->
                            <div class="dropzone-previews mt-3" id="file-previews"></div>
                            <p></p>
                            <div class="mb-3">
                                <label asp-for="PrepTime" class="form-label">Preparation time</label>
                                <input asp-for="PrepTime" class="form-control" />
                                <span asp-validation-for="PrepTime" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Nutrition Facts</label>

                                @for (int i = 0; i < Enum.GetValues(typeof(NutritionName)).Length; i++)
                                {

                                    <span asp-validation-for="NutritionValues[@i].Value" class="text-danger"></span>
                                    var nutrition = (NutritionName)Enum.GetValues(typeof(NutritionName)).GetValue(i);
                                    <div class="input-group mb-2">
                                        <span class="input-group-text">@nutrition</span>
                                        <input type="hidden" name="NutritionValues[@i].Name" value="@nutrition" />
                                        <input type="number" step="0.01" class="form-control" name="NutritionValues[@i].Value" />
                                    </div>
                                }
                            </div>


                            <div class="mb-3">
                                <label asp-for="Category" class="form-label">Category</label>

                                <select asp-for="Category" asp-items="Html.GetEnumSelectList<Category>()" class="form-control">
                                    <option value="">Select</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger"></span>
                            </div>

                            <div class="mb-3 form-check">
                                <input asp-for="IsAvailable" class="form-check-input" />
                                <label asp-for="IsAvailable" class="form-check-label"></label>
                                <span asp-validation-for="IsAvailable" class="text-danger"></span> @* ✅ validation display *@
                            </div>


                        </div>

                    </div> <!-- end col-->




                </div> <!-- end col-->
            </div>
            <!-- end row -->
            <span asp-validation-for="SelectedIngredientIds" class="text-danger"></span>

            <div id="ingredient-table-container">
                @await Html.PartialAsync("_IngredientTable", Model)
            </div>




            <div class="row">
                <a asp-action="MenuItems" class="btn btn-light">Cancel</a>

                <button type="submit" formaction="@Url.Action("Create", "Manager")" class="btn btn-success">Save</button>
            </div>
        </form>

        <!-- end row -->
        <!-- file preview template -->
        <div class="d-none" id="uploadPreviewTemplate">
            <div class="card mt-1 mb-0 shadow-none border">
                <div class="p-2">
                    <div class="row align-items-center">
                        @*  <div class="col-auto">
                            <img data-dz-thumbnail src="ecommerce-product-edit.html#" class="avatar-sm rounded bg-light" alt="">
                        </div> *@
                        <div class="col ps-0">
                            <a href="javascript:void(0);" class="text-muted fw-bold" data-dz-name></a>
                            <p class="mb-0" data-dz-size></p>
                        </div>
                        <div class="col-auto">
                            <!-- Button -->
                            <a href="ecommerce-product-edit.html" class="btn btn-link btn-lg text-muted" data-dz-remove>
                                <i class="dripicons-cross"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </div> <!-- container -->

</div> <!-- content -->
@section Scripts {
    <script>
        let selectedIngredients = {};

        function collectSelectedIngredients() {
            document.querySelectorAll("input[name^='IngredientQuantities']").forEach(input => {
                const id = input.name.match(/\d+/)[0];
                const value = parseFloat(input.value) || 0;

                if (value > 0) {
                    selectedIngredients[id] = value;

                    // ✅ Automatically check the checkbox
                    const cb = document.querySelector(`input[name='SelectedIngredientIds'][value='${id}']`);
                    if (cb) cb.checked = true;
                } else {
                    delete selectedIngredients[id];
                    const cb = document.querySelector(`input[name='SelectedIngredientIds'][value='${id}']`);
                    if (cb) cb.checked = false;
                }
            });
        }

        function restoreSelections() {
            Object.entries(selectedIngredients).forEach(([id, qty]) => {
                const cb = document.querySelector(`input[name='SelectedIngredientIds'][value='${id}']`);
                const input = document.querySelector(`input[name='IngredientQuantities[${id}]']`);

                if (input) input.value = qty;
                if (cb) cb.checked = true;
            });
        }

        function bindQuantityAutoCheck() {
            document.querySelectorAll("input[name^='IngredientQuantities']").forEach(input => {
                input.addEventListener("input", () => {
                    const id = input.name.match(/\d+/)[0];
                    const qty = parseFloat(input.value) || 0;

                    selectedIngredients[id] = qty;

                    const cb = document.querySelector(`input[name='SelectedIngredientIds'][value='${id}']`);
                    if (cb) cb.checked = qty > 0;
                });
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelector('form').addEventListener('submit', function () {
                collectSelectedIngredients();
                document.querySelectorAll('.dynamic-ingredient-fields').forEach(e => e.remove());

                Object.entries(selectedIngredients).forEach(([id, qty]) => {
                    let checkbox = document.createElement('input');
                    checkbox.type = 'hidden';
                    checkbox.name = 'SelectedIngredientIds';
                    checkbox.value = id;
                    checkbox.classList.add('dynamic-ingredient-fields');
                    this.appendChild(checkbox);

                    let quantity = document.createElement('input');
                    quantity.type = 'hidden';
                    quantity.name = `IngredientQuantities[${id}]`;
                    quantity.value = qty;
                    quantity.classList.add('dynamic-ingredient-fields');
                    this.appendChild(quantity);
                });
            });

            // initial bind if quantities are present
            bindQuantityAutoCheck();
        });

        function loadCreatePage(pageNumber) {
            collectSelectedIngredients();

            $.get('/Manager/LoadIngredientTableForCreate', { pageNumber: pageNumber }, function (data) {
                $('#ingredient-table-container').html(data);
                restoreSelections();
                bindQuantityAutoCheck(); // rebind events on new elements
            });
        }
    </script>
}

