@model CreateMenuItemViewModel
@{
    var totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
    var buttonClass = ViewData["ButtonClass"]?.ToString() ?? "create-page-btn";
    var isEdit = buttonClass == "edit-page-btn";
}

<div id="ingredient-table-content">
    @if (Model.AvailableIngredients != null && Model.AvailableIngredients.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Ingredient</th>
                    <th>Unit</th>
                    <th>Stock</th>
                    <th>Min Level</th>
                    <th>Select</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ingredient in Model.AvailableIngredients)
                {
                    <tr>
                        <td>@ingredient.Name</td>
                        <td>@ingredient.Unit</td>
                        <td>@ingredient.QuantityInStock</td>
                        <td>@ingredient.MinimumStockLevel</td>
                        <td>
                            <input type="checkbox"
                                   name="SelectedIngredientIds"
                                   value="@ingredient.Id"
                            @(Model.SelectedIngredientIds?.Contains(ingredient.Id) == true ? "checked" : "") />

                            <input type="number"
                                   name="IngredientQuantities[@ingredient.Id]"
                                   min="0"
                                   value="@(Model.IngredientQuantities != null && Model.IngredientQuantities.TryGetValue(ingredient.Id, out var qty) ? qty : 0)" />

                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="pagination-controls mt-2">
            Page @Model.PageNumber of @totalPages
            <div>
                @if (Model.PageNumber > 1)
                {
                    if (isEdit)
                    {
                        <button type="button"
                                class="btn btn-secondary edit-page-btn"
                                data-page="@(Model.PageNumber - 1)"
                                data-menu-id="@Model.Id">
                            Previous
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-secondary"
                                onclick="loadCreatePage(@(Model.PageNumber - 1))">
                            Previous
                        </button>
                    }
                }

                @if (Model.PageNumber < totalPages)
                {
                    if (isEdit)
                    {
                        <button type="button"
                                class="btn btn-secondary edit-page-btn"
                                data-page="@(Model.PageNumber + 1)"
                                data-menu-id="@Model.Id">
                            Next
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-secondary"
                                onclick="loadCreatePage(@(Model.PageNumber + 1))">
                            Next
                        </button>
                    }
                }
            </div>
        </div>

    }
    else
    {
        <p>No ingredients available.</p>
    }
</div>
