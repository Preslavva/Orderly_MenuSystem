@model IngredientListViewModel
@{
    ViewData["Title"] = "Menu Management";
    Layout = "_ManagerLayout";
}

<div class="container">
    
    <div class="col-12"> 
        <div class="row mb-4 mt-4 align-items-center">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h3 mb-0">🧂 Ingredient Stock</h1>
                </div>
            <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" id="searchInput" class="form-control" placeholder="Search ingredients...">
                        <button class="btn btn-outline-secondary" type="button">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0 d-flex justify-content-end align-items-center gap-2">
                <!-- Filter -->
                <div class="dropdown">
                    <button class="btn btn-outline-primary dropdown-toggle" type="button" id="categoryFilterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        Filter by Category
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="categoryFilterDropdown">
                        <li><a class="dropdown-item" href="#" data-category="all">All Categories</a></li>
                        <li><a class="dropdown-item" href="#" data-category="g">Grams</a></li>
                        <li><a class="dropdown-item" href="#" data-category="ml">Milliliters</a></li>
                        <li><a class="dropdown-item" href="#" data-category="pcs">Pieces</a></li>
                    </ul>
                </div>
                <!-- Low Stock Filter -->
                <button id="lowStockFilterBtn" class="btn btn-outline-danger">
                    <i class="bi bi-exclamation-triangle me-1"></i> Low Stock Only
                </button>

                <!-- Create button -->
                <a class="btn btn-primary" href="#" data-bs-toggle="modal" data-bs-target="#ingredient-modal">
                    <i class="fa fa-plus me-1"></i> Add Ingredient
                </a>
            </div>
        </div>
    </div>

       
        <div class="modal fade" id="ingredient-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-md">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add New Ingredient</h5>
                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="ingredientForm">
                            <div class="mb-3">
                                <label for="ingredientName" class="form-label">Name</label>
                                <input type="text" class="form-control" id="ingredientName" required>
                            </div>
                            <div class="mb-3">
                                <label for="quantity" class="form-label">Quantity in Stock</label>
                                <input type="number" class="form-control" id="quantity" required>
                            </div>
                            <div class="mb-3">
                                <label for="minimumStock" class="form-label">Minimum Stock Level</label>
                                <input type="number" class="form-control" id="minimumStockLevel" required>
                            </div>
                            <div class="mb-3">
                                <label for="unit" class="form-label">Unit</label>
                                <select id="unit" class="form-select" required>
                                    <option value="g">Grams (g)</option>
                                    <option value="ml">Milliliters (ml)</option>
                                    <option value="pcs">Pieces</option>
                                </select>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" type="submit" form="ingredientForm">Add</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="editIngredientModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-md">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Ingredient</h5>
                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form id="editIngredientForm">
                            <input type="hidden" id="editId" />

                            <div class="mb-3">
                                <label for="editName" class="form-label">Name</label>
                                <input type="text" class="form-control" id="editName">
                            </div>
                            <div class="mb-3">
                                <label for="editQuantity" class="form-label">Quantity</label>
                                <input type="number" class="form-control" id="editQuantity">
                            </div>
                            <div class="mb-3">
                                <label for="minimumStockLevel" class="form-label">Minimum Stock Level</label>
                                <input type="number" class="form-control" id="editMinimumStockLevel" required>
                            </div>
                            <div class="mb-3">
                                <label for="editUnit" class="form-label">Unit</label>
                                <select class="form-select" id="editUnit">
                                    <option value="g">g</option>
                                    <option value="ml">ml</option>
                                    <option value="pcs">pcs</option>
                                </select>
                            </div>
                        </form>

                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-primary" type="submit" form="editIngredientForm">Save Changes</button>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="row justify-content-center">
        <div class="col-11">

        <div id="ingredient-table-container">
            @await Html.PartialAsync("_IngredientTableManagePartial", Model)
        </div>

       
    </div>

   @*  custom page num *@
@* <form method="get" class="d-inline ms-3">
    <input type="number" name="pageNumber" min="1" max="@(Math.Ceiling((double)Model.TotalItems / Model.PageSize))" class="form-control d-inline" style="width: 80px;" />
    <button type="submit" class="btn btn-sm btn-outline-secondary">Go</button>
</form> *@

    <!-- end row -->
    <p></p>
</div>

<script>
    // Global state
    const ingredientManager = {
        currentSearch: "",
        currentCategory: "all",
        selectedIngredientIds: [],
        ingredientQuantities: {},
        lowStockFilterActive: false // Added this state
    };

    // DOM Ready
     document.addEventListener("DOMContentLoaded", () => {
        console.log("✅ DOM fully loaded");

        // Initialize all functionality
        initSearchAndFilter();
        initPagination();
        initIngredientForm();
        initEditForm();
        initDeleteHandlers();
        initLowStockFilter(); // Added this initialization
    });

       function initLowStockFilter() {
        const lowStockBtn = document.getElementById("lowStockFilterBtn");
        if (!lowStockBtn) return;

        lowStockBtn.addEventListener("click", function () {
            ingredientManager.lowStockFilterActive = !ingredientManager.lowStockFilterActive;
            reloadIngredientTable();

            this.classList.toggle("btn-danger", ingredientManager.lowStockFilterActive);
            this.classList.toggle("btn-outline-danger", !ingredientManager.lowStockFilterActive);
            this.innerHTML = ingredientManager.lowStockFilterActive
                ? '<i class="bi bi-exclamation-triangle me-1"></i> Showing Low Stock'
                : '<i class="bi bi-exclamation-triangle me-1"></i> Low Stock Only';
        });
    }

    // Search and Filter functionality
    function initSearchAndFilter() {
        const searchInput = document.getElementById("searchInput");
        const categoryLinks = document.querySelectorAll(".dropdown-menu a[data-category]");

        if (searchInput) {
            searchInput.addEventListener("input", function () {
                ingredientManager.currentSearch = this.value.toLowerCase().trim();
                reloadIngredientTable();
            });
        }

        categoryLinks.forEach(link => {
            link.addEventListener("click", function (e) {
                e.preventDefault();
                ingredientManager.currentCategory = this.dataset.category;
                document.getElementById("categoryFilterDropdown").textContent = this.textContent.trim();
                reloadIngredientTable();
            });
        });
    }

    // Pagination handling
    function initPagination() {
        bindPaginationButtons();
    }

    function bindPaginationButtons() {
        document.querySelectorAll(".page-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                const page = this.dataset.page;
                reloadIngredientTable(page);
            });
        });
    }

    // Table reload helper
    function reloadIngredientTable(page = 1) {
         const params = new URLSearchParams({
             pageNumber: page,
             search: ingredientManager.currentSearch,
             category: ingredientManager.currentCategory,
             lowStockOnly: ingredientManager.lowStockFilterActive // Added this parameter
         });

         fetch(`/Manager/LoadIngredientTablePartial?${params}`)
             .then(res => res.text())
             .then(html => {
                 const container = document.getElementById("ingredient-table-container");
                 if (container) {
                     container.innerHTML = html;
                     bindPaginationButtons();
                     bindEditHandlers();
                     bindDeleteHandlers();
                     applyLowStockFilter();
                 }
             })
             .catch(err => console.error("❌ Table reload failed:", err));
     }

    // Add Ingredient Form
    function initIngredientForm() {
        const form = document.getElementById("ingredientForm");
        if (!form) return;

        form.addEventListener("submit", function (e) {
            e.preventDefault();
            submitIngredientForm(this);
        });
    }

    function submitIngredientForm(form) {
        const data = {
            name: form.querySelector("#ingredientName").value,
            unit: form.querySelector("#unit").value,
            quantityInStock: parseInt(form.querySelector("#quantity").value),
            minimumStockLevel: parseInt(form.querySelector("#minimumStockLevel").value)
        };

        fetch("/Manager/AddIngredient", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
            },
            body: JSON.stringify(data)
        })
        .then(handleResponse)
        .then(() => {
            alert("✅ Ingredient added!");
            location.reload();
        })
        .catch(handleError);
    }

    // Edit Ingredient functionality
    function initEditForm() {
        bindEditHandlers();

        const editForm = document.getElementById("editIngredientForm");
        if (editForm) {
            editForm.addEventListener("submit", function (e) {
                e.preventDefault();
                submitEditForm(this);
            });
        }
    }

    function bindEditHandlers() {
        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const id = this.dataset.id;
                loadIngredientForEdit(id);
            });
        });
    }

    function loadIngredientForEdit(id) {
        fetch(`/Manager/GetIngredientById/${id}`)
            .then(response => response.json())
            .then(data => {
                document.getElementById('editId').value = data.id;
                document.getElementById('editName').value = data.name;
                document.getElementById('editQuantity').value = data.quantityInStock;
                document.getElementById('editMinimumStockLevel').value = data.minimumStockLevel;
                document.getElementById('editUnit').value = data.unit;
            })
            .catch(err => {
                alert("❌ Failed to load ingredient details.");
                console.error(err);
            });
    }

    function submitEditForm(form) {
        const data = {
            id: parseInt(form.querySelector("#editId").value),
            name: form.querySelector("#editName").value,
            unit: form.querySelector("#editUnit").value,
            quantityInStock: parseInt(form.querySelector("#editQuantity").value),
            minimumStockLevel: parseInt(form.querySelector("#editMinimumStockLevel").value)
        };

        fetch("/Manager/UpdateIngredient", {
            method: "PUT",
            headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
            },
            body: JSON.stringify(data)
        })
        .then(handleResponse)
        .then(() => {
            alert("✅ Ingredient updated successfully!");
            location.reload();
        })
        .catch(handleError);
    }

    // Delete functionality
    function initDeleteHandlers() {
        bindDeleteHandlers();
    }

    function bindDeleteHandlers() {
        document.querySelectorAll(".delete-btn").forEach(btn => {
            btn.addEventListener("click", handleDelete);
        });
    }

    function handleDelete() {
        const id = this.dataset.id;
        if (!confirm("❗ Are you sure you want to delete this ingredient?")) return;

        fetch(`/Manager/DeleteIngredient/${id}`, {
            method: "DELETE"
        })
        .then(handleResponse)
        .then(() => {
            alert("✅ Ingredient deleted!");
            location.reload();
        })
        .catch(handleError);
    }

    // Helper functions
    function handleResponse(resp) {
        if (!resp.ok) {
            return resp.text().then(text => { throw new Error(text); });
        }
        return resp.json();
    }

             


    function handleError(err) {
        console.error("❌ Error:", err);
        alert("❌ Error: " + (err.message || "Something went wrong"));
    }

</script>
