@model MenuItemDetailViewModel
@{
    ViewData["Title"] = "Menu Item Details";
    Layout = "_ManagerLayout";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">@Model.Name</h2>
            <span class="badge @(Model.IsAvailable ? "bg-success" : "bg-danger") fs-6">
                @(Model.IsAvailable ? "Available" : "Unavailable")
            </span>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <img src="@Model.Picture" class="img-fluid rounded" alt="@Model.Name">
                </div>
                <div class="col-md-8">
                    <div class="mb-3">
                        <h5 class="text-primary">Description</h5>
                        <p>@Model.Description</p>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h5 class="text-primary">Price</h5>
                            <p class="fs-4 fw-bold text-success">@Model.FormattedPrice</p>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-primary">Category</h5>
                            <p>@Model.Category</p>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-controller="Manager" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                        <a asp-controller="Manager" asp-action="MenuItems" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Menu Items
                        </a>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header bg-light">
                            <h4 class="mb-0">Ingredients</h4>
                        </div>
                        <div class="card-body">
                            @if (Model?.Ingredients == null || !Model.Ingredients.Any())
                            {
                                <p class="text-muted">No ingredients have been added to this menu item.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Ingredient</th>
                                                <th>Quantity</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (MenuItemIngredientViewModel ingredient in Model.Ingredients.Where(i => i.Quantity > 0))
                                            {
                                                <tr>
                                                    <td>@ingredient.IngredientName</td>
                                                    <td>@ingredient.FormattedQuantity</td>
                                                    <td>
                                                        @if (ingredient.StockAvailable > 0)
                                                        {
                                                            <span class="badge bg-success">In Stock</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-danger">Low Stock</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                <div class="mt-3">
                                    <h6>Availability Status:</h6>

                                    @if (Model.Ingredients.All(i => i.StockAvailable > 0))
                                    {
                                        <div class="alert alert-success">
                                            <i class="bi bi-check-circle"></i> All ingredients are available to make this item.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning">
                                            <i class="bi bi-exclamation-triangle"></i> Some ingredients are low in stock. This might affect availability.
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                    </div>
                </div>
                <!-- this is the nutrition column-->
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header bg-light">
                            <h4 class="mb-0">Nutrition Information</h4>
                        </div>
                        <div class="card-body">
                            @if (Model.Nutritions.Count == 0)
                            {
                                <p class="text-muted">No nutrition information has been added to this menu item.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <thead>
                                            <tr>
                                                <th>Nutrient</th>
                                                <th>Value</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (NutritionViewModel nutrition in Model.Nutritions)
                                            {
                                                <tr>
                                                    <td>@nutrition.Name</td>
                                                    <td>@nutrition.Value</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@Model.Name</strong>?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-controller="Manager" asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>