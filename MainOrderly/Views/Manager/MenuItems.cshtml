@model List<MainOrderly.WebApp.ViewModels.MenuItemViewModel>
@using System.ComponentModel.DataAnnotations

@{
    ViewData["Title"] = "Menu Management";
    Layout = "_ManagerLayout";
    string selected = ViewBag.SelectedCategory as string ?? "all";
}

@functions {
    string GetDisplayName(Enum value)
    {
        var field = value.GetType().GetField(value.ToString());
        var attr = field?.GetCustomAttributes(typeof(DisplayAttribute), false)
                         .FirstOrDefault() as DisplayAttribute;
        return attr?.Name ?? value.ToString();
    }
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Menu Items Management</h1>
        <a asp-controller="Manager" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add New Menu Item
        </a>
    </div>

    <div class="row mb-3">

        <div class="col-md-6">
           
        </div>

        <div class="col-md-6">
            <div class="d-flex justify-content-end">
                <div class="dropdown">
                    <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="categoryFilter" data-bs-toggle="dropdown" aria-expanded="false">
                        Filter by Category
                    </button>
                    <ul class="dropdown-menu" aria-labelledby="categoryFilter">
                        <li>
                            <a class="dropdown-item @(selected == "all" ? "active" : "")"
                               href="@Url.Action("MenuItems", "Manager", new { category = "all" })">
                                All Categories
                            </a>
                        </li>
                        @foreach (Models.Enums.Category category in Enum.GetValues(typeof(Models.Enums.Category)))
                        {
                            var enumValue = category.ToString();
                            <li>
                                <a class="dropdown-item @(selected == enumValue ? "active" : "")"
                                   href="@Url.Action("MenuItems", "Manager", new { category = enumValue })">
                                    @GetDisplayName(category)  
                                </a>
                            </li>
                        }


                    </ul>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No menu items found. Click "Add New Menu Item" to create your first menu item.
        </div>
    }
    else
    {
        <div class="row" id="menuItemsContainer">
            @foreach (var item in Model)
            {
                <div class="col-md-3 mb-3 menu-item-card" data-category="@item.Category">
                    <div class="card h-100">
                        <img src="@item.Picture" class="card-img-top menu-item-image" alt="@item.Name">
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text text-truncate">@item.Description</p>
                            <p class="text-primary fw-bold">@item.Price.ToString("C")</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge @(item.IsAvailable ? "bg-success" : "bg-danger")">
                                    @(item.IsAvailable ? "Available" : "Unavailable")
                                </span>
                                <span class="badge bg-info">@GetDisplayName(item.Category)</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="d-flex justify-content-between">
                                <a asp-controller="Manager" asp-action="MenuItemDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Details
                                </a>
                                <a asp-controller="Manager" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>


