@model IngredientListViewModel

<div class="table-responsive">
    <table class="table table-centered table-nowrap mb-0">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Quantity in Stock</th>
                <th>Unit</th>
                <th>Minimum Stock</th>
                <th>Status</th>
                <th style="width: 125px;">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model.Ingredients)
            {
                var status = i.QuantityInStock < i.MinimumStockLevel ? "Low" : "In Stock";
                var badgeClass = status == "Low" ? "bg-danger" : "bg-success";

                <tr class="ingredient-row"
                    data-unit="@i.Unit.ToLower()"
                    data-quantity="@Convert.ToDouble(i.QuantityInStock)"
                    data-minimum="@Convert.ToDouble(i.MinimumStockLevel)">
                    <td>@i.Id</td>
                    <td>@i.Name</td>
                    <td>@i.QuantityInStock</td>
                    <td>@i.Unit</td>
                    <td>@i.MinimumStockLevel</td>
                    <td><span class="badge @badgeClass">@status</span></td>
                    <td>
                        <a href="javascript:void(0);" class="action-icon edit-btn"
                           data-id="@i.Id" data-bs-toggle="modal" data-bs-target="#editIngredientModal">✏️</a>
                        <a href="javascript:void(0);" class="action-icon delete-btn" data-id="@i.Id">🗑️</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.Pagination.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            @if (Model.Pagination.HasPreviousPage)
            {
                <button type="button" class="btn btn-outline-secondary page-btn" data-page="@(Model.Pagination.Page - 1)">Previous</button>
            }

            <span>Page @Model.Pagination.Page of @Model.Pagination.TotalPages</span>

            @if (Model.Pagination.HasNextPage)
            {
                <button type="button" class="btn btn-outline-secondary page-btn" data-page="@(Model.Pagination.Page + 1)">Next</button>
            }
        </div>
    }
</div>
