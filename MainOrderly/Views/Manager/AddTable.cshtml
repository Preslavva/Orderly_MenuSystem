@model int

@{
    ViewData["Title"] = "Add Table";
    Layout = "_ManagerLayout";
}

<h1 class="mt-3" style="padding-left: 3rem;">Add a new Table</h1>

<h4 class="fst-italic text-secondary mt-3 mb-4" style="padding-left: 3rem;">
    There are currently <strong>@Model</strong> tables in the restaurant.
</h4>

<form asp-controller="Manager" asp-action="AddNewTable">
    <button type="submit" class="btn btn-success" style="margin-left: 3rem;">
        <i class="bi bi-plus-circle me-2" ></i>
        Create Table @(Model + 1) with QR code</button>
</form>