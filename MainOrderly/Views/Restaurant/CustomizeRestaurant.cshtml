@model RestaurantViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "CustomizeRestaurant";
    var user = Context.Session.GetAuthenticatedUser();
}

<head>
    @* Load Google Fonts dynamically *@
    @foreach (var fontItem in Model.Fonts)
    {
        var fontFamilyForUrl = fontItem.Text.Replace(" ", "+");
        <link href="https://fonts.googleapis.com/css2?family=@fontFamilyForUrl&display=swap" rel="stylesheet" />
    }

    <style>
        @* Define CSS classes for each font option *@
        @foreach (var fontItem in Model.Fonts)
        {
            var fontFamily = fontItem.Text;
            var safeFontClass = fontFamily.Replace(" ", "-").ToLowerInvariant();
            <text>
                option.font-@safeFontClass {
                    font-family: '@fontFamily', sans-serif;
                }
            </text>
        }
    </style>
</head>

<h1 class="preview-area">Customize your restaurant</h1>
<hr />
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row justify-content-center preview-area">
    <div class="col-md-10">
        <form asp-controller="Restaurant" asp-action="CustomizeRestaurant" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center"></div>
            <input asp-for="Id" type="hidden" />

            <div class="row">
                <div class="col-md-4 text-center">
                    <label class="form-label fw-bold d-block">Current Picture:</label>
                    @if (!string.IsNullOrEmpty(Model.Logo))
                    {
                        <img src="data:image/jpg;base64,@Model.Logo" class="img-thumbnail mb-2" alt="Restaurant Logo" style="max-width: 100%; height: auto;" />
                        <input type="hidden" name="Logo" value="@Model.Logo" />
                    }
                    else
                    {
                        <p class="text-muted">No logo uploaded.</p>
                    }
                </div>

                <div class="col-md-8">
                    <div class="mb-3">
                        <label asp-for="LogoImage" class="form-label">Choose new logo:</label>
                        <input asp-for="LogoImage" type="file" class="form-control" />
                        <span asp-validation-for="LogoImage" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label for="Font" class="form-label">Font:</label>
                        <select name="Font" id="Font" class="form-select">
                            <option value="">Select a Font</option>
                            @foreach (var fontItem in Model.Fonts)
                            {
                                var fontFamily = fontItem.Text;
                                var safeFontClass = fontFamily.Replace(" ", "-").ToLowerInvariant();
                                var value = fontItem.Value;
                                var selected = (Model.Font == value) ? " selected" : "";
                                @: <option class="font-@safeFontClass" value="@value"@selected>@fontFamily</option>
                            }
                        </select>
                        <span class="text-danger">@ViewData.ModelState["Font"]?.Errors.FirstOrDefault()?.ErrorMessage</span>
                    </div>



                    <div class="row mb-3">
                        <div class="col-6 d-flex justify-content-start">
                            <div class="form-check">
                                <input asp-for="IncludePayment" class="form-check-input" type="checkbox" />
                                <label asp-for="IncludePayment" class="form-check-label"></label>
                                <span asp-validation-for="IncludePayment" class="text-danger d-block"></span>
                            </div>
                        </div>
                        <div class="col-6 d-flex justify-content-end">
                            <div class="form-check">
                                <input asp-for="IncludeAniAbuse" class="form-check-input" type="checkbox" />
                                <label asp-for="IncludeAniAbuse" class="form-check-label"></label>
                                <span asp-validation-for="IncludeAniAbuse" class="text-danger d-block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-4 text-start d-flex flex-column align-items-start">
                            <label asp-for="ColorBackground" class="form-label">Background Color:</label>
                            <input asp-for="ColorBackground" type="color" class="form-control form-control-color" style="width: 80px; height: 40px;" />
                            <span asp-validation-for="ColorBackground" class="text-danger"></span>
                        </div>
                        <div class="col-4 text-center d-flex flex-column align-items-center">
                            <label asp-for="ColorButtons" class="form-label">Buttons Color:</label>
                            <input asp-for="ColorButtons" type="color" class="form-control form-control-color" style="width: 80px; height: 40px;" />
                            <span asp-validation-for="ColorButtons" class="text-danger"></span>
                        </div>
                        <div class="col-4 text-end d-flex flex-column align-items-end">
                            <label asp-for="ColorDeafult" class="form-label">Default Color:</label>
                            <input asp-for="ColorDeafult" type="color" class="form-control form-control-color" style="width: 80px; height: 40px;" />
                            <span asp-validation-for="ColorDeafult" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary">Update</button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
