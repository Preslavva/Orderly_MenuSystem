@model List<OrderViewModel>

<style>
    .card-custom {
        border: 1px solid #d1d5db;
        border-radius: 20px;
        background-color: white;
        padding: 15px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
        height: 100%;
    }

    .delivered-btn {
        background-color: #ef4444;
        color: white;
        border: none;
        border-radius: 30px;
        padding: 10px 25px;
        font-size: 1rem;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .delivered-btn:hover {
            background-color: #dc2626;
        }
</style>

@if (TempData["Message"] != null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999">
        <div class="toast show align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @TempData["Message"]
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<div class="container mt-4">
    <div class="row g-4">
        @if (Model.Count > 0)
        {
            @foreach (var order in Model)
            {
                <div class="col-md-4 d-flex">
                    <div class="card-custom w-100 d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="mb-3">Order @order.Id (Table @order.Table)</h5>
                            <ul class="list-unstyled">
                                @foreach (var item in order.Items)
                                {
                                    <li>@item.Name x @item.Quantity</li>
                                }
                            </ul>
                        </div>
                        <form hx-post="@Url.Action("DeliverOrder", "Waiter")"
                              hx-target="#waiter-orders-container"
                              hx-swap="innerHTML"
                              class="mt-auto">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <button type="submit" class="delivered-btn mt-3">Delivered</button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="mt-3 text-center">No orders at the moment.</p>
            </div>
        }
    </div>
</div>