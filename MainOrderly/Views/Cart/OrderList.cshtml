@model Dictionary<MenuItem,int>


@{
    ViewData["Title"] = "My Order";
}

<link rel="stylesheet" href="~/css/cart.css" />

<h2 class="main-title">My Order</h2>

@if (Model != null && Model.Any())
{
    <div class="cart-container">
        @foreach (var item in Model)
        {
            <div class="cart-item">
                <div class="cart-item-img">
                    <img src="@item.Key.Picture" alt="@item.Key.Name" />
                </div>
                <div class="cart-item-details">
                    <h3>@item.Key.Name</h3>
                    <p>@item.Key.Price.ToString("C")</p>
                </div>

                <div class="cart-item-actions">
                    <form asp-controller="Cart" asp-action="UpdateItemQuantity" method="post" class="quantity-form">
                        <input type="hidden" name="id" value="@item.Key.Id" />
                        <div class="quantity-wrapper">
                            <button type="submit" class="quantity-btn decrease-btn" @(item.Value == 1 ? "disabled" : "") onclick="this.parentNode.querySelector('input[name=quantity]').value--; this.form.submit(); return false;">-</button>
                            <input type="number" name="quantity" value="@item.Value" min="1" class="quantity-input" readonly />
                            <button type="submit" class="quantity-btn increase-btn" onclick="this.parentNode.querySelector('input[name=quantity]').value++; this.form.submit(); return false;">+</button>
                        </div>
                    </form>

                    <form asp-controller="Cart" asp-action="RemoveItemFromCart" method="post">
                        <input type="hidden" name="id" value="@item.Key.Id" />
                        <input type="submit" value="Remove" class="btn remove-btn" />
                    </form>
                </div>
            </div>
            <hr class="cart-divider" />
        }
    </div>

    <div class="cart-total">
        <span>Total price:</span>
        <span>@ViewBag.TotalPrice.ToString("C")</span>
    </div>

    <form asp-controller="Cart" asp-action="GoToOrderSummary" method="post">
        <input type="submit" value="Order Now" class="btn btn-order-now" />
    </form>
}
else
{
    <p class="empty-cart-message">No items in the cart.</p>
}