@model List<MenuItemViewModel>

@foreach (var group in Model.GroupBy(i => i.Category))
{
    <div class="menu-category-group" data-category="@group.Key">
        <div class="category-title-wrapper">
            @* <h2 class="category-name">@group.Key.GetDisplayName()</h2> *@
        </div>

        <div class="row">

            @foreach (var item in group)
            {
                <div class="col-md-6 col-lg-4">

                    <!-- Card (grays itself out when unavailable) -->
                    <div class="card @(item.IsAvailable ? "" : "unavailable")">

                        @* 🔴 Top-right badge shown only when stock is gone *@
                        @if (!item.IsAvailable)
                        {
                            <span class="badge-unavailable">Not&nbsp;available</span>
                        }

                        <img src="@item.Picture" alt="@item.Name" class="img-fluid" />

                        <div class="card-content">
                            <h3>@item.Name</h3>
                            <p>Price: €@item.Price</p>

                            <div class="buttons">
                                <!-- Info button — always active -->
                                <a asp-controller="Home"
                                   asp-action="GetItemInfo"
                                   asp-route-id="@item.Id"
                                   asp-route-category="@group.Key">
                                    <button class="info-button" type="button">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"
                                             fill="currentColor" class="bi bi-info-square-fill"
                                             viewBox="0 0 16 16">
                                            <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm8.93 4.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM8 5.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2" />
                                        </svg>
                                    </button>
                                </a>

                                <!-- Add-to-cart (disabled + grey when unavailable) -->
                                <form asp-controller="Home" asp-action="AddToCart">
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="submit" value="Add to cart"
                                    @(item.IsAvailable ? "" : "disabled") />
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
}
