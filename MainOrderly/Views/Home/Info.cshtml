@model CompositeViewModelMenuItemNutrition

@{
    ViewData["Title"] = "Info Page";
}
<div class="container d-flex justify-content-center align-items-center">
    <div class="card food-card shadow-lg">
        <a asp-controller="Home" asp-action="Index">
            <button type="button" class="btn-close close-button" aria-label="Close"></button>
        </a>

        <div class="image-container2">
            <img src="@Model.MenuItemViewModel.Picture" alt="@Model.MenuItemViewModel.Name">
        </div>

        <div class="card-body2">
            <h1 class="card-title">@Model.MenuItemViewModel.Name</h1>
            <p class="card-text">@Model.MenuItemViewModel.Description</p>

            <div class="nutritions row text-center">
            @foreach (var nutrition in Model.NutritionViewModel)
            {
                <div class="col-6 col-md-3">
                    <img src="/images/@(nutrition.Name).png" alt="@nutrition.Name"> <br>
                @nutrition.Value @((nutrition.Name == NutritionName.Kcal) ? "Kcal" : "g")
                </div>
            }
            </div>
            </div>
        </div>
    </div>
</div>
