                          }
                          else if (nutrition.Name == NutritionName.Fats)
                          {
                    <svg fill="var(--background-color)" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="70px" height="70px" viewBox="-7 -7 84.00 84.00" enable-background="new 0 0 70 70" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"><rect x="-7" y="-7" width="84.00" height="84.00" rx="42" fill="var(--primary-color)" strokewidth="0"></rect></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <path d="M59.892,12.361c-0.413-0.884-4.61-8.645-24.58-8.645c-20.223,0-24.952,8.129-25.144,8.477 c-0.304,0.551-0.33,1.147-0.071,1.722l23.392,51.752c0.323,0.717,1.037,0.916,1.823,0.916c0.003,0,0.007,0,0.01,0 c0.79,0,1.504-0.216,1.821-0.939L59.912,14.02C60.143,13.493,60.136,12.883,59.892,12.361z M35.312,7.749 c14.059,0,19.07,4.11,20.484,5.702l-1.434,3.268c-2.213-2.083-7.468-5.209-19.093-5.209c-11.759,0-17.242,3.188-19.56,5.252 l-1.47-3.26C15.837,11.842,21.21,7.749,35.312,7.749z M39.861,13.7c4.23,0.362,7.255,1.204,9.386,2.134 c-0.606,2.579-3.195,4.184-5.779,3.589C40.902,18.826,39.299,16.266,39.861,13.7z M27.089,42.002 c0.06-0.013,0.12-0.012,0.179-0.036c1.09-0.454,2.291-0.456,3.383-0.006c1.091,0.45,1.942,1.298,2.395,2.389 c0.454,1.09,0.456,2.291,0.006,3.383c-0.44,1.065-1.263,1.896-2.317,2.356L27.089,42.002z M35.287,60.185l-3.732-8.277 c1.521-0.672,2.71-1.872,3.346-3.414c0.654-1.585,0.65-3.33-0.008-4.913c-0.659-1.584-1.895-2.815-3.479-3.469 c-1.586-0.653-3.33-0.65-4.914,0.009c-0.077,0.032-0.134,0.086-0.198,0.134l-9.725-21.57c1.523-1.597,6.318-5.174,18.693-5.174 c0.904,0,1.762,0.021,2.584,0.058c-0.615,3.531,1.629,6.981,5.162,7.802c0.516,0.12,1.033,0.178,1.543,0.178 c2.937,0,5.592-1.925,6.485-4.8c1.247,0.74,2.012,1.453,2.449,1.95l-5.475,12.475c-1.039-0.692-2.269-1.082-3.555-1.082 c-3.539,0-6.418,2.881-6.418,6.421c0,3.014,2.091,5.543,4.896,6.229L35.287,60.185z M43.768,40.86 c-2.104-0.337-3.722-2.15-3.722-4.349c0-2.438,1.981-4.421,4.418-4.421c1.0