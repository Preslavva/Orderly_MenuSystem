                        <div class="small">
                            @if (nutrition.Name != NutritionName.Kcal)
                            {
                                @nutrition.Name <br />
                            }
                            else{
                                @:Calories<br />
                            }
                            @nutrition.Value @(nutrition.Name == NutritionName.Kcal ? "Kcal" : "g")
                        </div>
                    </div>
                }
            </div>




            <div class="allergen-icons">
                @foreach (var allergen in Model.AllergenViewModel)
                {
                    <div class="allergen-icon">
                        <img src="/images/@(allergen.Name).png" alt="@allergen.Name" />
                    </div>
                }
            </div>

            </div>
   


