@model IEnumerable<MenuItemViewModel>

@{
    var continents = Enum.GetValues(typeof(Continent));
    ViewData["Title"] = "Home Page";
}


<form method="get" action="@Url.Action("Index", "Home")">
    <div class="group">
        <svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
            <g>
                <path d="M21.53 20.47l-3.66-3.66C19.195 15.24 20 13.214 20 11c0-4.97-4.03-9-9-9s-9 4.03-9 9 4.03 9 9 9c2.215 0 4.24-.804 5.808-2.13l3.66 3.66c.147.146.34.22.53.22s.385-.073.53-.22c.295-.293.295-.767.002-1.06zM3.5 11c0-4.135 3.365-7.5 7.5-7.5s7.5 3.365 7.5 7.5-3.365 7.5-7.5 7.5-7.5-3.365-7.5-7.5z"></path>
            </g>
        </svg>
        <input type="search" class="input" name="searchTerm" placeholder="Search" value="@Context.Request.Query["searchTerm"]">
    </div>
</form>



<div class="continent-container">
    @foreach (var continent in continents)
    {
        <button class="continent" onclick="location.href='#@continent'">
            @continent
            <img src="/images/@(continent).png" alt="@continent Image">
        </button>
    }
</div>



@if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>@ViewBag.ErrorMessage</strong>
    </div>
}


@foreach (var continentGroup in  Model.GroupBy(m => m.Continent))
{
    <h2 class="continent-name" id="@continentGroup.Key">@continentGroup.Key</h2>
    <hr></hr>

    <div class="row">
        @foreach (var item in continentGroup)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card">
                    <img src="@item.Picture" alt="@item.Name" class="img-fluid" />
                    <div class="card-content">
                        <h3>@item.Name</h3>

                        <a asp-controller="Home" asp-action="GetItemInfo" asp-route-id="@item.Id">
                            <button class="info-button">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-info-square-fill" viewBox="0 0 16 16">
                                    <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm8.93 4.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM8 5.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2" />
                                </svg>
                            </button>
                        </a>

                        <p>Price: €@item.Price</p>

                        <form asp-controller="Home" asp-action="AddToCart">
                            <input type="hidden" name="quantity" value="1" min="1" />
                            <input type="submit" value="Add to cart" />
                            <input type="hidden" name="id" value="@item.Id" />
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}



