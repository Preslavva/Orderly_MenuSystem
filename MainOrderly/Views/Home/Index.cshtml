@using Models.Enums
@model List<MenuItemViewModel>

@{
    var categoriesFromModel = ((List<Category>)ViewBag.AllCategories)
    .OrderBy(c => c == Category.Starters ? 0 : 1)
    .ToList();
    

    ViewData["Title"] = "Home Page";
}


<div class="sticky-panel">
    <div class="category-tabs">
        <ul class="tab-list">
            @foreach (var category in categoriesFromModel)
            {
                var selected = Context.Request.Query["category"];
                var isActive = string.IsNullOrEmpty(selected) && category == Category.Starters
                || selected == category.ToString()
                ? "active" : "";

                <li class="tab-item @isActive">
                    <a href="@Url.Action("Index", new { category = category })">
                        @category.GetDisplayName()
                    </a>
                </li>
            }

        </ul>

    </div>

    <input type="text" id="searchInput" placeholder="Search menu items..." autocomplete="off" />

    <div id="searchResults" class="scrollable-results">
        @await Html.PartialAsync("_MenuItemList", Model)
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>@ViewBag.ErrorMessage</strong>
    </div>
}

<!-- Modal HTML -->
<div class="modal fade" id="notAvailableModal" tabindex="-1" aria-labelledby="notAvailableModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-warning text-dark">
				<h5 class="modal-title" id="notAvailableModalLabel">Item Unavailable</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				@TempData["NotAvailable"]
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
			</div>
		</div>
	</div>
</div>


@section Scripts {
	<script>
        document.addEventListener("DOMContentLoaded", function () {
            var notAvailableMessage = '@TempData["NotAvailable"]';
            if (notAvailableMessage && notAvailableMessage.trim() !== '') {
                var modal = new bootstrap.Modal(document.getElementById('notAvailableModal'));
                modal.show();
            }
        });
    </script>
}








