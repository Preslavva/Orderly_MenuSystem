@model List<MenuItemViewModel>


@{
    // var categories = Enum.GetValues(typeof(Category)).Cast<Category>().ToList();
    var categoriesFromModel = Model.Select(item => item.Category).Distinct().ToList();
    ViewData["Title"] = "Home Page";
}

<div class="category-tabs">
    <ul class="tab-list">
        <li class="tab-item active" data-category="All">All</li>
        @foreach (var category in categoriesFromModel) // IS THIS ALLOWED??
        {
            <li class="tab-item" data-category="@category">@category.GetDisplayName()</li>
        }
    </ul>
</div>



<input type="text" id="searchInput" placeholder="Search menu items..." autocomplete="off" class="form-control mb-3" />

<div id="searchResults">
    @await Html.PartialAsync("_MenuItemList", Model) 
</div>



@if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>@ViewBag.ErrorMessage</strong>
    </div>
}




