@using Models.Enums
@model List<MenuItemViewModel>

@{
    var categoriesFromModel = ((List<Category>)ViewBag.AllCategories)
    .OrderBy(c => c == Category.Starters ? 0 : 1)
    .ToList();


    ViewData["Title"] = "Home Page";
}

<div class="sticky-panel">
    <div class="category-tabs">
        <ul class="tab-list">
            @foreach (var category in categoriesFromModel)
            {
                var selected = Context.Request.Query["category"];
                var isActive = string.IsNullOrEmpty(selected) && category == Category.Starters
                || selected == category.ToString()
                ? "active" : "";

                <li class="tab-item @isActive">
                    <a href="@Url.Action("Index", new { category = category })">
                        @category.GetDisplayName()
                    </a>
                </li>
            }

        </ul>

    </div>

    <input type="text" id="searchInput" placeholder="Search menu items..." autocomplete="off" />

    <div id="searchResults" class="scrollable-results">
        @await Html.PartialAsync("_MenuItemList", Model)
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(ViewBag.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>@ViewBag.ErrorMessage</strong>
    </div>
}




